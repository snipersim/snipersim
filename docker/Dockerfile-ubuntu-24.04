FROM ubuntu:24.04
# Necessary for tzdata
ENV DEBIAN_FRONTEND=noninteractive
ARG TZ_ARG=UTC
ENV TZ=${TZ_ARG}
RUN apt-get update && apt-get install -y \
    python3 \
    python3-dev \
    python3-venv \
    screen \
    tmux \
    binutils \
 && rm -rf /var/lib/apt/lists/*
# For building Sniper
RUN apt-get update && apt-get install -y \
    automake \
    build-essential \
    cmake \
    curl \
    wget \
    libboost-dev \
    libsqlite3-dev \
    zlib1g-dev \
    libbz2-dev \
    libdb++-dev \
 && rm -rf /var/lib/apt/lists/*
# For the dependencies deps/sniper-deps builds: QEMU (ninja, glib, pixman),
# DynamoRIO and Capstone (cmake), the RISC-V guests (clang, lld), ccache
RUN apt-get update && apt-get install -y \
    ninja-build \
    pkg-config \
    libglib2.0-dev \
    libpixman-1-dev \
    liblzma-dev \
    ccache \
    clang \
    lld \
    python3-numpy \
    python3-yaml \
 && rm -rf /var/lib/apt/lists/*
# Helper utilities
RUN apt-get update && apt-get install -y \
    gdb \
    gfortran \
    git \
    g++ \
    vim \
 && rm -rf /var/lib/apt/lists/*
