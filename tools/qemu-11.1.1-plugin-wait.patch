diff --git a/plugins/api-system.c b/plugins/api-system.c
index fbf905c..4ec7022 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -131 +131,14 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
 }
+
+/*
+ * Waiting outside the run loop needs a cpu loop that handles
+ * EXCP_PLUGIN_WAIT, which only Linux user mode's do: in system mode the
+ * exit would reach the vcpu thread's loop, which knows nothing of it.  A
+ * plugin checks qemu_info_t.system_emulation before using the call.
+ */
+void qemu_plugin_vcpu_wait_at(uint64_t vaddr, qemu_plugin_vcpu_wait_cb_t cb, void *udata,
+                              uintptr_t host_pc)
+{
+    error_report("qemu_plugin_vcpu_wait_at: Linux user mode only, not in system mode");
+    abort();
+}
diff --git a/plugins/api-user.c b/plugins/api-user.c
index 28704a8..9f87942 100644
--- a/plugins/api-user.c
+++ b/plugins/api-user.c
@@ -15,2 +15,5 @@
 #include "exec/log.h"
+#include "accel/tcg/cpu-loop.h"
+#include "exec/cpu-common.h"
+#include "hw/core/cpu.h"
 
@@ -57 +60,39 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
 }
+
+/*
+ * Waiting outside the run loop: EXCP_PLUGIN_WAIT is handled by the
+ * linux-user cpu loops (qemu_plugin_vcpu_wait_run()), so user mode only;
+ * the system-mode call refuses (api-system.c).
+ */
+void qemu_plugin_vcpu_wait_at(uint64_t vaddr, qemu_plugin_vcpu_wait_cb_t cb, void *udata,
+                              uintptr_t host_pc)
+{
+    /*
+     * Only from a callback of a running vcpu (an exec callback, in the run
+     * loop) with register access, and not twice: the cpu loop runs one
+     * wait callback per exit.
+     */
+    g_assert(current_cpu);
+    g_assert(qatomic_read(&current_cpu->running));
+    g_assert(qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_RW_REGS ||
+             qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_RW_REGS_PC);
+    g_assert(current_cpu->plugin_state && !current_cpu->plugin_state->wait_cb);
+
+    current_cpu->plugin_state->wait_cb = cb;
+    current_cpu->plugin_state->wait_udata = udata;
+    /*
+     * The translator writes some state only when it has to -- the PC at
+     * the end of a block, x86's cc_op before a helper that reads the flags.
+     * A callback in the middle of a block sees the values as of the last
+     * such write; leaving from here with them would resume with the
+     * flags of an earlier instruction.  The block's unwind data has the
+     * state at this instruction's start, which is where execution resumes.
+     * A block-level callback's return address precedes the first
+     * instruction's code and restores nothing, nor needs to: a block
+     * begins with everything written.
+     */
+    cpu_restore_state(current_cpu, host_pc);
+    cpu_set_pc(current_cpu, vaddr);
+    current_cpu->exception_index = EXCP_PLUGIN_WAIT;
+    cpu_loop_exit(current_cpu);
+}
diff --git a/plugins/core.c b/plugins/core.c
index 1113bfe..a1a7f11 100644
--- a/plugins/core.c
+++ b/plugins/core.c
@@ -208,2 +208,20 @@ CPUPluginState *qemu_plugin_create_vcpu_state(void)
 
+/* calls the plugin's function: no CFI checks, as for the callbacks above */
+QEMU_DISABLE_CFI
+void qemu_plugin_vcpu_wait_run(CPUState *cpu)
+{
+    CPUPluginState *st = cpu->plugin_state;
+    void (*cb)(unsigned int, void *) = st ? st->wait_cb : NULL;
+
+    if (!cb) {
+        return;
+    }
+    st->wait_cb = NULL;
+    /* outside the run loop the registers are all in memory: a full access */
+    qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_RW_REGS);
+    cb(cpu->cpu_index, st->wait_udata);
+    qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_NO_REGS);
+    st->wait_udata = NULL;
+}
+
 static void plugin_grow_scoreboards__locked(CPUState *cpu)
