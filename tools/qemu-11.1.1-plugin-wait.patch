The plugin wait call for QEMU 11.1.1: qemu_plugin_vcpu_wait_at() lets a
plugin callback leave the run loop the way a system call does, so that a
vCPU waiting for something outside QEMU (Sniper's answer) holds up no
exclusive section.  The state at the instruction is restored from the
block's unwind data, the PC set to it, EXCP_PLUGIN_WAIT unwinds to the
linux-user cpu loop (x86-64, RISC-V, AArch64), the plugin's callback runs
there after cpu_exec_end() with register access, and execution resumes at
the instruction.  Applied by deps/sniper-deps to the x86-64, RISC-V (on top
of tools/riscv/qemu-11.1.1-ime.patch) and AArch64 user-mode builds; one line
of context, so that it applies on the stock tree and on the IME one alike.
Used by frontend/qemu-plugin/sniper_qemu.cc ("waiting").

diff --git a/include/exec/cpu-common.h b/include/exec/cpu-common.h
index 6594f7f..1ce7a3b 100644
--- a/include/exec/cpu-common.h
+++ b/include/exec/cpu-common.h
@@ -19,2 +19,3 @@
 #define EXCP_ATOMIC     0x10005 /* stop-the-world and emulate atomic */
+#define EXCP_PLUGIN_WAIT 0x10006 /* a plugin asked to wait outside the run loop (qemu_plugin_vcpu_wait) */
 
diff --git a/include/plugins/qemu-plugin.h b/include/plugins/qemu-plugin.h
index 3e913cd..f186aed 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -1158,2 +1158,53 @@ void qemu_plugin_set_pc(uint64_t vaddr);
 
+/**
+ * typedef qemu_plugin_vcpu_wait_cb_t - callback run outside the run loop
+ * @vcpu_index: the vcpu
+ * @udata: the argument given to qemu_plugin_vcpu_wait()
+ */
+typedef void (*qemu_plugin_vcpu_wait_cb_t)(unsigned int vcpu_index, void *udata);
+
+/**
+ * qemu_plugin_vcpu_wait_at() - leave the run loop, call back, resume
+ * @vaddr: the virtual address of the instruction to resume at
+ * @cb: the callback to run outside the run loop
+ * @udata: passed to @cb
+ * @host_pc: the exec callback's return address into the translated code
+ *
+ * A plugin callback that has to wait for something outside QEMU -- an
+ * answer from another process, say -- cannot block where it is: the vcpu
+ * counts as running, an exclusive section elsewhere waits for it, and a
+ * translation-block flush in that section may reuse the code the parked
+ * vcpu would return to.  This leaves the run loop instead, the way a
+ * system call does: the vcpu stops at @vaddr, @cb runs once the vcpu is no
+ * longer running (in the cpu loop, after cpu_exec_end()), with register
+ * and memory access as in a QEMU_PLUGIN_CB_RW_REGS callback, and execution
+ * resumes at @vaddr -- whose callbacks therefore fire again, which the
+ * plugin must expect.  Does not return.
+ *
+ * Leaving in the middle of a block is what a faulting instruction does,
+ * and needs the same care: state the translator tracks lazily (the PC, and
+ * on x86 the pending flags operation) is restored from the block's unwind
+ * data at @host_pc before the exit, as cpu_loop_exit_restore() does for a
+ * helper.  Use qemu_plugin_vcpu_wait(), which supplies @host_pc, directly
+ * in the exec callback registered with QEMU -- from a function it calls,
+ * the return address is not in translated code and nothing is restored.
+ * Only from an exec callback registered with QEMU_PLUGIN_CB_RW_REGS or
+ * QEMU_PLUGIN_CB_RW_REGS_PC (asserted), and only in Linux user mode, whose
+ * cpu loops run @cb: in system mode the call reports an error and aborts,
+ * so a plugin checks qemu_info_t.system_emulation before it uses it.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_vcpu_wait_at(uint64_t vaddr, qemu_plugin_vcpu_wait_cb_t cb, void *udata,
+                              uintptr_t host_pc);
+
+/**
+ * qemu_plugin_vcpu_wait() - qemu_plugin_vcpu_wait_at() from the exec callback
+ *
+ * Expands in the exec callback itself, so that the return address it passes
+ * is the callback's own -- into the translated code.
+ */
+#define qemu_plugin_vcpu_wait(vaddr, cb, udata) \
+    qemu_plugin_vcpu_wait_at((vaddr), (cb), (udata), \
+                             (uintptr_t)__builtin_return_address(0))
+
 /**
diff --git a/include/qemu/plugin.h b/include/qemu/plugin.h
index 9c2ec8c..ccc25de 100644
--- a/include/qemu/plugin.h
+++ b/include/qemu/plugin.h
@@ -146,2 +146,5 @@ struct qemu_plugin_tb {
 struct CPUPluginState {
+    /* qemu_plugin_vcpu_wait_at: the callback to run outside the run loop */
+    void (*wait_cb)(unsigned int vcpu_index, void *udata);
+    void *wait_udata;
     DECLARE_BITMAP(event_mask, QEMU_PLUGIN_EV_MAX);
@@ -159,2 +162,9 @@ void qemu_plugin_vcpu_init_hook(CPUState *cpu);
 void qemu_plugin_vcpu_exit_hook(CPUState *cpu);
+/*
+ * The vcpu left its run loop with EXCP_PLUGIN_WAIT: run the callback the
+ * plugin registered with qemu_plugin_vcpu_wait(), from outside the loop --
+ * the vcpu is not running as far as exclusive sections are concerned, so
+ * the callback may block.
+ */
+void qemu_plugin_vcpu_wait_run(CPUState *cpu);
 void qemu_plugin_tb_trans_cb(CPUState *cpu, struct qemu_plugin_tb *tb);
@@ -251,2 +261,5 @@ static inline int qemu_plugin_load_list(QemuPluginList *head, Error **errp)
 
+static inline void qemu_plugin_vcpu_wait_run(CPUState *cpu)
+{ }
+
 static inline void qemu_plugin_vcpu_init_hook(CPUState *cpu)
