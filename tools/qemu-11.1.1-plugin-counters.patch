The plugin counter callback for QEMU 11.1.1: qemu_plugin_register_counter_cb()
lets a plugin answer the guest's direct reads of its clocks and counters,
which Linux user mode answers from the host -- RISC-V's time, cycle and
instret CSRs (cpu_get_host_ticks(), in no defined unit), AArch64's
CNTVCT_EL0 (the host's clock at CNTFRQ) and PMCCNTR_EL0, x86's TSC.  A
simulator the guest runs on answers them with the time of its model, so a
guest timing itself sees simulated time; without a plugin's answer the
host's values are returned as before.  The callback is called within the
instruction and must not block: the plugin asks its question before the
instruction runs (outside the run loop with
tools/qemu-11.1.1-plugin-wait.patch, which this applies on top of).
Applied by deps/sniper-deps to the x86-64, RISC-V and AArch64 user-mode
builds; one line of context, so that it applies on the stock tree with the
wait patch and on the IME one alike.  Used by
frontend/qemu-plugin/sniper_qemu.cc ("counter").

diff --git a/include/plugins/qemu-plugin.h b/include/plugins/qemu-plugin.h
index 66bd45c..1dcb3fa 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -1207,2 +1207,50 @@ void qemu_plugin_vcpu_wait_at(uint64_t vaddr, qemu_plugin_vcpu_wait_cb_t cb, voi
 
+/**
+ * enum qemu_plugin_counter - a clock or counter the guest reads directly
+ * @QEMU_PLUGIN_COUNTER_TIME: a timer's count: RISC-V's time CSR, AArch64's
+ *   CNTVCT_EL0
+ * @QEMU_PLUGIN_COUNTER_CYCLES: a cycle count: RISC-V's cycle CSR, AArch64's
+ *   PMCCNTR_EL0, x86's time-stamp counter
+ * @QEMU_PLUGIN_COUNTER_INSTRET: instructions retired: RISC-V's instret CSR
+ */
+#define QEMU_PLUGIN_HAS_COUNTER_CB 1   /* tools/qemu-11.1.1-plugin-counters.patch */
+enum qemu_plugin_counter {
+    QEMU_PLUGIN_COUNTER_TIME,
+    QEMU_PLUGIN_COUNTER_CYCLES,
+    QEMU_PLUGIN_COUNTER_INSTRET,
+};
+
+/**
+ * typedef qemu_plugin_counter_cb_t - answer a guest's counter read
+ * @vcpu_index: the vcpu reading
+ * @counter: which counter
+ * @freq_hz: the counter's rate as the guest is told it (AArch64's CNTFRQ),
+ *   or 0 where QEMU gives none (RISC-V's timebase in user mode)
+ * @host_value: the value QEMU would return (from the host's clock)
+ * @udata: as registered
+ *
+ * Returns the value the guest reads, in the counter's units and of its
+ * full width (QEMU takes the high half itself where the guest asks for it).
+ * Called from within the instruction, in the run loop: it must not block.
+ */
+typedef uint64_t (*qemu_plugin_counter_cb_t)(unsigned int vcpu_index,
+                                             enum qemu_plugin_counter counter,
+                                             uint64_t freq_hz, uint64_t host_value,
+                                             void *udata);
+
+/**
+ * qemu_plugin_register_counter_cb() - let the plugin answer counter reads
+ * @id: plugin id
+ * @cb: the callback (NULL: the host's values again)
+ * @udata: passed to @cb
+ *
+ * In user mode the guest's clocks and counters read the host's: its time,
+ * its cycle counter.  A plugin that models time -- a simulator the guest
+ * runs on -- answers them instead, so that a guest timing itself sees the
+ * time of the model.  Linux user mode on x86-64, RISC-V and AArch64.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_counter_cb(qemu_plugin_id_t id, qemu_plugin_counter_cb_t cb,
+                                     void *udata);
+
 /**
diff --git a/include/qemu/plugin.h b/include/qemu/plugin.h
index ccc25de..153efe8 100644
--- a/include/qemu/plugin.h
+++ b/include/qemu/plugin.h
@@ -169,2 +169,8 @@ void qemu_plugin_vcpu_exit_hook(CPUState *cpu);
 void qemu_plugin_vcpu_wait_run(CPUState *cpu);
+/*
+ * A guest counter read in user mode: the plugin's value if one registered
+ * qemu_plugin_register_counter_cb(), otherwise @host_value.
+ */
+uint64_t qemu_plugin_counter_read(CPUState *cpu, enum qemu_plugin_counter counter,
+                                  uint64_t freq_hz, uint64_t host_value);
 void qemu_plugin_tb_trans_cb(CPUState *cpu, struct qemu_plugin_tb *tb);
@@ -264,2 +270,8 @@ static inline void qemu_plugin_vcpu_wait_run(CPUState *cpu)
 
+static inline uint64_t qemu_plugin_counter_read(CPUState *cpu, enum qemu_plugin_counter counter,
+                                                uint64_t freq_hz, uint64_t host_value)
+{
+    return host_value;
+}
+
 static inline void qemu_plugin_vcpu_init_hook(CPUState *cpu)
diff --git a/linux-user/i386/cpu_loop.c b/linux-user/i386/cpu_loop.c
index cea58cb..db3883b 100644
--- a/linux-user/i386/cpu_loop.c
+++ b/linux-user/i386/cpu_loop.c
@@ -33,3 +33,5 @@ uint64_t cpu_get_tsc(CPUX86State *env)
 {
-    return cpu_get_host_ticks();
+    /* or a plugin's answer (qemu_plugin_register_counter_cb) */
+    return qemu_plugin_counter_read(env_cpu(env), QEMU_PLUGIN_COUNTER_CYCLES, 0,
+                                    cpu_get_host_ticks());
 }
diff --git a/plugins/api.c b/plugins/api.c
index 7454ce2..3acf002 100644
--- a/plugins/api.c
+++ b/plugins/api.c
@@ -526,2 +526,21 @@ void qemu_plugin_vcpu_wait_at(uint64_t vaddr, qemu_plugin_vcpu_wait_cb_t cb, voi
 
+static qemu_plugin_counter_cb_t counter_cb;
+static void *counter_udata;
+
+void qemu_plugin_register_counter_cb(qemu_plugin_id_t id, qemu_plugin_counter_cb_t cb,
+                                     void *udata)
+{
+    qatomic_set(&counter_udata, udata);
+    qatomic_set(&counter_cb, cb);
+}
+
+uint64_t qemu_plugin_counter_read(CPUState *cpu, enum qemu_plugin_counter counter,
+                                  uint64_t freq_hz, uint64_t host_value)
+{
+    qemu_plugin_counter_cb_t cb = qatomic_read(&counter_cb);
+
+    return cb ? cb(cpu->cpu_index, counter, freq_hz, host_value,
+                   qatomic_read(&counter_udata)) : host_value;
+}
+
 void qemu_plugin_set_pc(uint64_t vaddr)
