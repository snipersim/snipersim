diff --git a/target/riscv/tcg/csr.c b/target/riscv/tcg/csr.c
index 23fc77e..477e520 100644
--- a/target/riscv/tcg/csr.c
+++ b/target/riscv/tcg/csr.c
@@ -1061,6 +1061,29 @@ static RISCVException write_vcsr(CPURISCVState *env, int csrno,
 #if defined(CONFIG_USER_ONLY)
-/* User Timers and Counters */
-static target_ulong get_ticks(bool shift)
+#include "qemu/plugin.h"
+/*
+ * User Timers and Counters: the host's ticks, or a plugin's answer
+ * (qemu_plugin_register_counter_cb) for time, cycle and instret.
+ */
+static uint64_t user_counter(CPURISCVState *env, int csrno)
+{
+    uint64_t host = cpu_get_host_ticks();
+
+    switch (csrno) {
+    case CSR_TIME:
+    case CSR_TIMEH:
+        return qemu_plugin_counter_read(env_cpu(env), QEMU_PLUGIN_COUNTER_TIME, 0, host);
+    case CSR_CYCLE:
+    case CSR_CYCLEH:
+        return qemu_plugin_counter_read(env_cpu(env), QEMU_PLUGIN_COUNTER_CYCLES, 0, host);
+    case CSR_INSTRET:
+    case CSR_INSTRETH:
+        return qemu_plugin_counter_read(env_cpu(env), QEMU_PLUGIN_COUNTER_INSTRET, 0, host);
+    default:
+        return host;
+    }
+}
+
+static target_ulong get_ticks(CPURISCVState *env, int csrno, bool shift)
 {
-    int64_t val = cpu_get_host_ticks();
+    int64_t val = user_counter(env, csrno);
     target_ulong result = shift ? val >> 32 : val;
@@ -1073,3 +1096,3 @@ static RISCVException read_time(CPURISCVState *env, int csrno,
 {
-    *val = cpu_get_host_ticks();
+    *val = user_counter(env, csrno);
     return RISCV_EXCP_NONE;
@@ -1080,3 +1103,3 @@ static RISCVException read_timeh(CPURISCVState *env, int csrno,
 {
-    *val = cpu_get_host_ticks() >> 32;
+    *val = user_counter(env, csrno) >> 32;
     return RISCV_EXCP_NONE;
@@ -1087,3 +1110,3 @@ static RISCVException read_hpmcounter(CPURISCVState *env, int csrno,
 {
-    *val = get_ticks(false);
+    *val = get_ticks(env, csrno, false);
     return RISCV_EXCP_NONE;
@@ -1094,3 +1117,3 @@ static RISCVException read_hpmcounterh(CPURISCVState *env, int csrno,
 {
-    *val = get_ticks(true);
+    *val = get_ticks(env, csrno, true);
     return RISCV_EXCP_NONE;
