 /* Exceptions processing helpers */
+/*
+ * An exception raised by a plugin that emulates an instruction (see
+ * qemu_plugin_raise_exception): the PC is already the trapping
+ * instruction's, so there is no state to restore; the trap value is the
+ * instruction bits for an illegal instruction and the address otherwise.
+ */
+G_NORETURN void riscv_plugin_raise_exception(CPUState *cs, uint64_t cause,
+                                             uint64_t tval)
+{
+    CPURISCVState *env = cpu_env(cs);
+
+    if (cause == RISCV_EXCP_ILLEGAL_INST) {
+        env->bins = tval;
+    } else {
+        env->badaddr = tval;
+    }
+    riscv_raise_exception(env, cause, 0);
+}
+
