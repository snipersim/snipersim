+typedef struct {
+    int exp_bits, frac_bits, bias;
+    int has_inf;
+    int nan_is_emax_fmax; /* E4M3: only 0x7F is NaN */
+} Fmt;
+
+static const Fmt FMTS[] = {
+    [IME_FMT_F16]  = {5, 10, 15, 1, 0},
+    [IME_FMT_BF16] = {8,  7, 127, 1, 0},
+    [IME_FMT_E4M3] = {4,  3,  7, 0, 1},
+    [IME_FMT_E5M2] = {5,  2, 15, 1, 0},
+    [IME_FMT_E2M1] = {2,  1,  1, 0, 0},
+};
+
+int ime_fmt_bits(ImeFpFmt fmt)
+{
+    const Fmt *f = &FMTS[fmt];
+    return 1 + f->exp_bits + f->frac_bits;
+}
+
+typedef struct {
+    int s, nan, inf, zero;
+    int e;          /* unbiased, valid if finite nonzero */
+    uint64_t m;     /* significand with implicit bit at bit `frac_bits` */
+} Unp;
+
+static Unp unpack(uint32_t bits, const Fmt *f)
+{
+    Unp u = {0};
+    int w = 1 + f->exp_bits + f->frac_bits;
+    bits &= (w >= 32) ? 0xffffffffu : ((1u << w) - 1u);
+    u.s = (int)((bits >> (f->exp_bits + f->frac_bits)) & 1);
+    int re = (int)((bits >> f->frac_bits) & ((1u << f->exp_bits) - 1u));
+    uint32_t frac = bits & ((1u << f->frac_bits) - 1u);
+    int emax = (1 << f->exp_bits) - 1;
+    if (f->nan_is_emax_fmax) {
+        if (re == emax && frac == ((1u << f->frac_bits) - 1u)) {
+            u.nan = 1;
+            return u;
+        }
+    } else if (f->has_inf && re == emax) {
+        u.nan = frac != 0;
+        u.inf = frac == 0;
+        return u;
+    }
+    if (re == 0) {
+        if (frac == 0) {
+            u.zero = 1;
+            return u;
+        }
+        /* subnormal */
+        u.e = 1 - f->bias;
+        u.m = frac;
+        while (u.m && (u.m & (1ull << f->frac_bits)) == 0) {
+            u.m <<= 1;
+            u.e--;
+        }
+        return u;
+    }
+    u.e = re - f->bias;
+    u.m = frac | (1ull << f->frac_bits);
+    return u;
+}
+
+static uint32_t pack(Unp u, const Fmt *f)
+{
+    int w = 1 + f->exp_bits + f->frac_bits;
+    uint32_t mask = (w >= 32) ? 0xffffffffu : ((1u << w) - 1u);
+    int emax = (1 << f->exp_bits) - 1;
+    if (u.nan) {
+        if (f->nan_is_emax_fmax)
+            return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits | ((1u << f->frac_bits) - 1u);
+        return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits | 1u;
+    }
+    if (u.inf) {
+        if (!f->has_inf) {
+            /* overflow → max finite */
+            return (uint32_t)(u.s << (w - 1)) | ((uint32_t)(emax - (f->nan_is_emax_fmax ? 0 : 0)) << f->frac_bits)
+                   | ((1u << f->frac_bits) - 1u - (f->nan_is_emax_fmax ? 1u : 0));
+        }
+        return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits;
+    }
+    if (u.zero || u.m == 0)
+        return (uint32_t)u.s << (w - 1);
+    /* normalize */
+    while (u.m && u.m < (1ull << f->frac_bits)) {
+        u.m <<= 1;
+        u.e--;
+    }
+    while (u.m >= (2ull << f->frac_bits)) {
+        u.m >>= 1;
+        u.e++;
+    }
+    int re = u.e + f->bias;
+    if (re <= 0) {
+        /* subnormal / underflow */
+        int shift = 1 - f->bias - u.e;
+        if (shift > f->frac_bits + 2) return (uint32_t)u.s << (w - 1);
+        uint64_t sig = u.m;
+        uint64_t round = 0;
+        if (shift > 0) {
+            round = (sig >> (shift - 1)) & 1;
+            uint64_t sticky = sig & ((1ull << (shift - 1)) - 1ull);
+            sig >>= shift;
+            if (round && (sticky || (sig & 1))) sig++;
+        }
+        if (sig == 0) return (uint32_t)u.s << (w - 1);
+        return ((uint32_t)u.s << (w - 1)) | (uint32_t)(sig & ((1u << f->frac_bits) - 1u));
+    }
+    if (re >= emax) {
+        if (!f->has_inf) {
+            uint32_t maxf = ((1u << f->frac_bits) - 1u) - (f->nan_is_emax_fmax ? 1u : 0);
+            return ((uint32_t)u.s << (w - 1)) | ((uint32_t)(emax - (f->nan_is_emax_fmax ? 0 : 0)) << f->frac_bits) | maxf;
+        }
+        return ((uint32_t)u.s << (w - 1)) | ((uint32_t)emax << f->frac_bits);
+    }
+    uint32_t frac = (uint32_t)(u.m & ((1ull << f->frac_bits) - 1ull));
+    return ((uint32_t)u.s << (w - 1)) | ((uint32_t)re << f->frac_bits) | frac;
+}
+
+uint32_t ime_fma_precise(uint32_t ab, uint32_t bb, uint32_t cb, ImeFpFmt fmt)
+{
+    const Fmt *f = &FMTS[fmt];
+    Unp a = unpack(ab, f), b = unpack(bb, f), c = unpack(cb, f);
+    if (a.nan || b.nan || c.nan) {
+        Unp n = {0};
+        n.nan = 1;
+        return pack(n, f);
+    }
+    if (a.inf || b.inf) {
+        if ((a.zero || b.zero) && !a.inf != !b.inf) {
+            Unp n = {0};
+            n.nan = 1;
+            return pack(n, f);
+        }
+        Unp r = {0};
+        r.inf = 1;
+        r.s = a.s ^ b.s;
+        if (c.inf && c.s != r.s) {
+            r.inf = 0;
+            r.nan = 1;
+        }
+        return pack(r, f);
+    }
+    if (a.zero || b.zero) return pack(c, f);
+    if (c.inf) return pack(c, f);
+
+    int ps = a.s ^ b.s;
+    int pe = a.e + b.e;
+    uint64_t pm = a.m * b.m; /* up to 11*11=22 bits */
+    int pib = 2 * f->frac_bits; /* product implicit at bit pib */
+    /* normalize product so implicit at frac_bits */
+    int sh = pib - f->frac_bits;
+    /* keep extra GRS bits: work with implicit at bit 16 */
+    const int W = 16;
+    int pshift = W - pib;
+    uint64_t psig = (pshift >= 0) ? (pm << pshift) : (pm >> -pshift);
+    int pexp = pe;
+    while (psig && psig < (1ull << W)) {
+        psig <<= 1;
+        pexp--;
+    }
+    while (psig >= (2ull << W)) {
+        psig >>= 1;
+        pexp++;
+    }
+
+    if (c.zero) {
+        Unp r = {0};
+        r.s = ps;
+        r.e = pexp;
+        /* round from W+1 extra to frac_bits */
+        int drop = W - f->frac_bits;
+        uint64_t extra = psig & ((1ull << drop) - 1ull);
+        uint64_t mant = psig >> drop;
+        uint64_t half = 1ull << (drop - 1);
+        if (extra > half || (extra == half && (mant & 1))) mant++;
+        if (mant >= (2ull << f->frac_bits)) {
+            mant >>= 1;
+            r.e++;
+        }
+        r.m = mant;
+        return pack(r, f);
+    }
+
+    /* add c: implicit at W */
+    int cshift = W - f->frac_bits;
+    uint64_t csig = c.m << cshift;
+    int cexp = c.e;
+    while (csig && csig < (1ull << W)) {
+        csig <<= 1;
+        cexp--;
+    }
+
+    int de = pexp - cexp;
+    uint64_t x = psig, y = csig;
+    int xe = pexp, ys = c.s, xs = ps;
+    if (de < 0) {
+        uint64_t t = x;
+        x = y;
+        y = t;
+        int ts = xs;
+        xs = ys;
+        ys = ts;
+        xe = cexp;
+        de = -de;
+    }
+    if (de >= 60) y = 0;
+    else if (de > 0) {
+        uint64_t sticky = y & ((1ull << de) - 1ull);
+        y >>= de;
+        if (sticky) y |= 1;
+    }
+    uint64_t mag;
+    int rs;
+    if (xs == ys) {
+        mag = x + y;
+        rs = xs;
+        if (mag >= (2ull << W)) {
+            mag >>= 1;
+            xe++;
+        }
+    } else {
+        if (x >= y) {
+            mag = x - y;
+            rs = xs;
+        } else {
+            mag = y - x;
+            rs = ys;
+        }
+        if (mag == 0) {
+            Unp z = {0};
+            z.zero = 1;
+            return pack(z, f);
+        }
+        while (mag < (1ull << W)) {
+            mag <<= 1;
+            xe--;
+        }
+    }
+    int drop = W - f->frac_bits;
+    uint64_t extra = mag & ((1ull << drop) - 1ull);
+    uint64_t mant = mag >> drop;
+    uint64_t half = 1ull << (drop - 1);
+    if (drop > 0 && (extra > half || (extra == half && (mant & 1)))) mant++;
+    if (mant >= (2ull << f->frac_bits)) {
+        mant >>= 1;
+        xe++;
+    }
+    Unp r = {0};
+    r.s = rs;
+    r.e = xe;
+    r.m = mant;
+    return pack(r, f);
+}
+
+uint16_t ime_f16_fma_precise(uint16_t a, uint16_t b, uint16_t c)
+{
+    return (uint16_t)ime_fma_precise(a, b, c, IME_FMT_F16);
+}
+uint8_t ime_e4m3_fma_precise(uint8_t a, uint8_t b, uint8_t c)
+{
+    return (uint8_t)ime_fma_precise(a, b, c, IME_FMT_E4M3);
+}
+uint8_t ime_e5m2_fma_precise(uint8_t a, uint8_t b, uint8_t c)
+{
+    return (uint8_t)ime_fma_precise(a, b, c, IME_FMT_E5M2);
+}
+uint8_t ime_e2m1_fma_precise(uint8_t a, uint8_t b, uint8_t c)
