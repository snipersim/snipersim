+    int has_inf;
+    int nan_is_emax_fmax; /* E4M3: only 0x7F is NaN */
+} Fmt;
+
+static const Fmt FMTS[] = {
+    [IME_FMT_F16]  = {5, 10, 15, 1, 0},
+    [IME_FMT_BF16] = {8,  7, 127, 1, 0},
