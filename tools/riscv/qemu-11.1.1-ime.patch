+/*
+ * Plugin-defined registers: one set per vcpu, registered with the gdbstub
+ * as a coprocessor feature whose accessors call back into the plugin.
+ */
+struct plugin_regs {
+    GDBFeature feature;
+    unsigned int n;
+    unsigned int *bytes;
+    qemu_plugin_reg_read_cb_t read;
+    qemu_plugin_reg_write_cb_t write;
+    void *udata;
+};
+
+static int plugin_regs_get(CPUState *cpu, GByteArray *buf, int reg)
+{
+    struct plugin_regs *r = cpu->plugin_state->regs;
+    guint before = buf->len;
+    unsigned int want;
+
+    if (!r || (unsigned int)reg >= r->n) {
+        return 0;
+    }
+    want = r->bytes[reg];
+    r->read(cpu->cpu_index, reg, buf, r->udata);
+    /* gdb expects exactly the register's size */
+    if (buf->len - before < want) {
+        g_byte_array_set_size(buf, before + want);
+    } else if (buf->len - before > want) {
+        g_byte_array_set_size(buf, before + want);
+    }
+    return want;
+}
+
+static int plugin_regs_set(CPUState *cpu, uint8_t *mem_buf, int reg)
+{
+    struct plugin_regs *r = cpu->plugin_state->regs;
+
+    if (!r || (unsigned int)reg >= r->n) {
+        return 0;
+    }
+    if (r->write) {
+        r->write(cpu->cpu_index, reg, mem_buf, r->udata);
+    }
+    return r->bytes[reg];
+}
+
+bool qemu_plugin_register_vcpu_registers(unsigned int vcpu_index,
+                                         const char *feature, const char *tags,
+                                         const char *const names[], const unsigned int bits[],
+                                         const char *const types[], unsigned int n,
+                                         qemu_plugin_reg_read_cb_t read,
+                                         qemu_plugin_reg_write_cb_t write, void *udata)
+{
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+    struct plugin_regs *r;
+    GDBFeatureBuilder builder;
+    unsigned int i;
+
+    if (!cpu || !cpu->plugin_state || cpu->plugin_state->regs || !cpu->gdb_regs ||
+        !read || !n) {
+        return false;
+    }
+    r = g_new0(struct plugin_regs, 1);
+    r->n = n;
+    r->bytes = g_new0(unsigned int, n);
+    r->read = read;
+    r->write = write;
+    r->udata = udata;
+    gdb_feature_builder_init(&builder, &r->feature, g_strdup(feature),
+                             g_strdup_printf("%s.xml", feature), cpu->gdb_num_regs);
+    if (tags) {
+        gdb_feature_builder_append_tag(&builder, "%s", tags);
+    }
+    for (i = 0; i < n; i++) {
+        r->bytes[i] = (bits[i] + 7) / 8;
+        gdb_feature_builder_append_reg(&builder, g_strdup(names[i]), bits[i], i,
+                                       types[i], write ? NULL : "plugin");
+    }
+    gdb_feature_builder_end(&builder);
+    cpu->plugin_state->regs = r;
+    gdb_register_coprocessor(cpu, plugin_regs_get, write ? plugin_regs_set : NULL,
+                             &r->feature);
+    return true;
+}
