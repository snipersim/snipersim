+/**
+ * typedef qemu_plugin_vcpu_insn_claim_cb_t - claim callback
+ * @vcpu_index: the vcpu translating the instruction
+ * @insn: the instruction the target could not decode; qemu_plugin_insn_data,
+ *        _vaddr and _size describe it
+ * @udata: the pointer given at registration
+ *
+ * Called during translation, before the target emits the exception for an
+ * instruction it does not know.  A plugin that recognises the instruction
+ * registers its execution callbacks on @insn (qemu_plugin_register_vcpu_insn_exec_cb
+ * with QEMU_PLUGIN_CB_RW_REGS: the callback reads and writes registers and
+ * memory) and returns true; the target then emits nothing for the
+ * instruction and translation continues at the next one, so the emulated
+ * instruction costs one helper call instead of an exception, a loop exit
+ * and a block lookup.  The callbacks run at the instruction's start in
+ * program order with the plugin's other callbacks for it; they must not
+ * call qemu_plugin_set_pc unless the emulated instruction branches.
+ * Returns false to leave the instruction to the target.
+ */
