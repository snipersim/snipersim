+/*
+ * Called by the target's translator for an instruction it cannot decode,
+ * with tcg_ctx->plugin_insn describing it (its length is not known to the
+ * plugin layer yet: the target passes it).  The first plugin that claims
+ * the instruction owns it.
+ */
+QEMU_DISABLE_CFI
+bool qemu_plugin_insn_claim(CPUState *cpu, size_t len)
+{
+    struct qemu_plugin_cb *cb, *next;
+    enum qemu_plugin_event ev = QEMU_PLUGIN_EV_VCPU_INSN_CLAIM;
+    struct qemu_plugin_insn *insn = tcg_ctx->plugin_insn;
+
+    if (!insn || !test_bit(ev, cpu->plugin_state->event_mask)) {
+        return false;
+    }
+    insn->len = len;
+
+    QLIST_FOREACH_SAFE_RCU(cb, &plugin.cb_lists[ev], entry, next) {
+        qemu_plugin_vcpu_insn_claim_cb_t func = cb->f.vcpu_insn_claim;
+        bool claimed;
+
+        qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_RW_REGS);
+        claimed = func(cpu->cpu_index, insn, cb->udata);
+        qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_NO_REGS);
+        if (claimed) {
+            return true;
+        }
+    }
+    return false;
+}
