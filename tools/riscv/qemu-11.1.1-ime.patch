@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Generated from IME 0.9 UDB (Zvvm freeze, not ratified).
+ * QEMU parent 11.1.1. CPU properties x-zvvmm/x-zvvfmm/x-zvvmtls/x-zvvmttls
+ * default off. Do not treat SpacemiT/Xuantie as this ISA.
+ */
+
+#ifndef TARGET_RISCV_IME_H
+#define TARGET_RISCV_IME_H
+
+#include "qemu/osdep.h"
+
+typedef struct IMEGeom {
+    int L, M, N, Nmax, Keff, EMUL_C, linesize;
+    int EEW_C, EEW_A, lambda, lmul, W;
+    int vlen, sew, vl;
+    int illegal;
+} IMEGeom;
+
+int ime_decode_vlambda(int enc);
+int ime_permissible(int L, int lambda);
+int ime_emul_c(int L, int lambda);
+int ime_warl_lambda(int requested_enc, int L, int current_enc);
+int ime_decode_gemm(IMEGeom *g, int vlen, int sew, int lambda,
+                    int lmul, int W, int vl);
+int ime_tile_reg_idx(int i, int group_regs, int row_elems, int epr);
+int64_t ime_int_elem(const uint8_t *bytes, int eew, int signedness);
+void ime_int_gemm(const int64_t *A, const int64_t *B, int64_t *C,
+                  const IMEGeom *g, int signed_a, int signed_b);
+
+/* vtype IME fields: freeze 0.9 positions. */
+#define IME_VTYPE_LAMBDA_SHIFT_RV64  60
+#define IME_VTYPE_LAMBDA_MASK        7ull
+#define IME_VTYPE_BS_SHIFT_RV64      59
+#define IME_VTYPE_ALT_A_SHIFT_RV64   58
+#define IME_VTYPE_ALT_B_SHIFT_RV64   57
+#define IME_VTYPE_LAMBDA_SHIFT_RV32  28
+#define IME_VTYPE_BS_SHIFT_RV32      27
+#define IME_VTYPE_ALT_A_SHIFT_RV32   26
+#define IME_VTYPE_ALT_B_SHIFT_RV32   25
+
+#endif
--- a/target/riscv/tcg/ime_helper.c
+++ b/target/riscv/tcg/ime_helper.c
@@ -0,0 +1,218 @@
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "exec/helper-proto.h"
+#include "accel/tcg/cpu-ldst.h"
+#include "ime.h"
+
+static G_NORETURN void ime_illegal(CPURISCVState *env)
+{
+    riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, GETPC());
+}
+
+static int ime_sew(CPURISCVState *env)
+{
+    return 8 << FIELD_EX64(env->vtype, VTYPE, VSEW);
+}
+
+static int ime_lmul(CPURISCVState *env)
+{
+    uint32_t vlmul = FIELD_EX64(env->vtype, VTYPE, VLMUL);
+    if (vlmul > 3) {
+        return -1;
+    }
+    return 1 << vlmul;
+}
+
+static int ime_lambda_from_vtype(CPURISCVState *env)
+{
+    int xlen = riscv_cpu_xlen(env);
+    int shift = (xlen == 64) ? IME_VTYPE_LAMBDA_SHIFT_RV64
+                             : IME_VTYPE_LAMBDA_SHIFT_RV32;
+    return ime_decode_vlambda((int)((env->vtype >> shift) & 7));
+}
+
+static uint8_t *ime_vrf(CPURISCVState *env)
+{
+    return (uint8_t *)env->vreg;
+}
+
+static int ime_vlenb(CPURISCVState *env)
+{
+    return (int)env_archcpu(env)->cfg.vlenb;
+}
+
+static void ime_do_int(CPURISCVState *env, uint32_t vd, uint32_t vs1,
+                       uint32_t vs2, int W)
+{
+    if (env->vstart != 0) {
+        ime_illegal(env);
+    }
+    int lmul = ime_lmul(env);
+    if (lmul < 0) {
+        ime_illegal(env);
+    }
+    int lambda = ime_lambda_from_vtype(env);
+    if (lambda == 0) {
+        ime_illegal(env);
+    }
+    IMEGeom g;
+    if (ime_decode_gemm(&g, ime_vlenb(env) * 8, ime_sew(env),
+                        lambda, lmul, W, (int)env->vl)) {
+        ime_illegal(env);
+    }
+    if ((vd % g.EMUL_C) || (vs1 % g.lmul) || (vs2 % g.lmul)) {
+        ime_illegal(env);
+    }
+    ime_vrf_int_gemm(ime_vrf(env), ime_vlenb(env), &g,
+                     (int)vd, (int)vs1, (int)vs2, 1, 1);
+    env->vstart = 0;
+}
+
+static void ime_do_fp(CPURISCVState *env, uint32_t vd, uint32_t vs1,
+                      uint32_t vs2, int W, int mx)
+{
+    if (env->vstart != 0) {
+        ime_illegal(env);
+    }
+    int lmul = ime_lmul(env);
+    if (lmul < 0) {
+        ime_illegal(env);
+    }
+    int lambda = ime_lambda_from_vtype(env);
+    if (lambda == 0) {
+        ime_illegal(env);
+    }
+    IMEGeom g;
+    if (ime_decode_gemm(&g, ime_vlenb(env) * 8, ime_sew(env),
+                        lambda, lmul, W, (int)env->vl)) {
+        ime_illegal(env);
+    }
+    if (mx) {
+        ime_vrf_mx_gemm(ime_vrf(env), ime_vlenb(env), &g,
+                        (int)vd, (int)vs1, (int)vs2, g.Keff);
+    } else {
+        ime_vrf_fp_gemm(ime_vrf(env), ime_vlenb(env), &g,
+                        (int)vd, (int)vs1, (int)vs2);
+    }
+    env->vstart = 0;
+}
+
+void helper_vmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_int(env, vd, vs1, vs2, 1); }
+void helper_vwmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_int(env, vd, vs1, vs2, 2); }
+void helper_vqmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_int(env, vd, vs1, vs2, 4); }
+void helper_v8wmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_int(env, vd, vs1, vs2, 8); }
+void helper_vfmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 1, 0); }
+void helper_vfwmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 2, 0); }
+void helper_vfqmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 4, 0); }
+void helper_vf8wmmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 8, 0); }
+void helper_vfwimmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 2, 1); }
+void helper_vfqimmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 4, 1); }
+void helper_vf8wimmacc_vv(CPURISCVState *env, uint32_t vd, uint32_t vs1, uint32_t vs2)
+{ ime_do_fp(env, vd, vs1, vs2, 8, 1); }
+
+static uint64_t ime_ld_guest(CPURISCVState *env, target_ulong addr, int ebytes)
+{
+    uintptr_t ra = GETPC();
+    switch (ebytes) {
+    case 1: return cpu_ldub_data_ra(env, addr, ra);
+    case 2: return cpu_lduw_le_data_ra(env, addr, ra);
+    case 4: return cpu_ldl_le_data_ra(env, addr, ra);
+    case 8: return cpu_ldq_le_data_ra(env, addr, ra);
+    default: return 0;
+    }
+}
+
+static void ime_st_guest(CPURISCVState *env, target_ulong addr, int ebytes, uint64_t v)
+{
+    uintptr_t ra = GETPC();
+    switch (ebytes) {
+    case 1: cpu_stb_data_ra(env, addr, (uint8_t)v, ra); break;
+    case 2: cpu_stw_le_data_ra(env, addr, (uint16_t)v, ra); break;
+    case 4: cpu_stl_le_data_ra(env, addr, (uint32_t)v, ra); break;
+    case 8: cpu_stq_le_data_ra(env, addr, v, ra); break;
+    default: break;
+    }
+}
+
+static void ime_tile(CPURISCVState *env, uint32_t vd, target_ulong base,
+                     target_ulong ld, uint32_t lam_enc, int transpose, int store)
+{
+    int sew = ime_sew(env);
+    int lmul = ime_lmul(env);
+    if (lmul < 0) {
+        ime_illegal(env);
+    }
+    int lambda = lam_enc ? ime_decode_vlambda((int)lam_enc)
+                         : ime_lambda_from_vtype(env);
+    if (lambda <= 0) {
+        ime_illegal(env);
+    }
+    int vlenb = ime_vlenb(env);
+    int ebytes = sew / 8;
+    int epr = (vlenb * 8) / sew;
+    int linesize = lambda * lmul;
+    int M = epr / lambda;
+    int n = M * linesize;
+    uint64_t packed = transpose ? (uint64_t)M : (uint64_t)linesize;
+    if (ld == 0) {
+        ld = packed;
+    }
+    uint8_t *vrf = ime_vrf(env);
+    for (int i = 0; i < n; i++) {
+        int row = i / linesize;
+        int col = i % linesize;
+        target_ulong addr = transpose
+            ? base + (target_ulong)col * ld * ebytes + (target_ulong)row * ebytes
+            : base + (target_ulong)row * ld * ebytes + (target_ulong)col * ebytes;
+        int idx = ime_tile_reg_idx(i, lmul, lambda, epr);
+        if (store) {
+            ime_st_guest(env, addr, ebytes, ime_load_elem(vrf, vlenb, (int)vd, idx, sew));
+        } else {
+            ime_store_elem(vrf, vlenb, (int)vd, idx, sew, ime_ld_guest(env, addr, ebytes));
+        }
+    }
+    env->vstart = 0;
+}
+
+void helper_vmtl_v(CPURISCVState *env, uint32_t vd, target_ulong base,
+                   target_ulong ld, uint32_t vm, uint32_t lam)
+{ (void)vm; ime_tile(env, vd, base, ld, lam, 0, 0); }
+void helper_vmts_v(CPURISCVState *env, uint32_t vs3, target_ulong base,
+                   target_ulong ld, uint32_t vm, uint32_t lam)
+{ (void)vm; ime_tile(env, vs3, base, ld, lam, 0, 1); }
+void helper_vmttl_v(CPURISCVState *env, uint32_t vd, target_ulong base,
+                    target_ulong ld, uint32_t vm, uint32_t lam)
+{ (void)vm; ime_tile(env, vd, base, ld, lam, 1, 0); }
+void helper_vmtts_v(CPURISCVState *env, uint32_t vs3, target_ulong base,
+                    target_ulong ld, uint32_t vm, uint32_t lam)
+{ (void)vm; ime_tile(env, vs3, base, ld, lam, 1, 1); }
+
+target_ulong helper_ime_vsetlambda(CPURISCVState *env, target_ulong req)
+{
+    int xlen = riscv_cpu_xlen(env);
+    int shift = (xlen == 64) ? IME_VTYPE_LAMBDA_SHIFT_RV64
+                             : IME_VTYPE_LAMBDA_SHIFT_RV32;
+    int old = ime_decode_vlambda((int)((env->vtype >> shift) & 7));
+    int L = ime_sew(env) ? (ime_vlenb(env) * 8) / ime_sew(env) : 0;
+    int newlam = old > 0 ? old : 1;
+    if ((int64_t)req > 0 && ime_permissible(L, (int)req)) {
+        newlam = (int)req;
+    } else if (req == 0 && !ime_permissible(L, newlam)) {
+        for (int c = 8; c >= 1; c >>= 1) {
+            if (ime_permissible(L, c)) { newlam = c; break; }
+        }
+    }
+    int enc = newlam > 0 ? 32 - __builtin_clz(newlam) : 0;
+    env->vtype = (env->vtype & ~(7ull << shift)) | ((uint64_t)enc << shift);
+    return (target_ulong)old;
+}
--- a/target/riscv/tcg/ime_kern.c
+++ b/target/riscv/tcg/ime_kern.c
@@ -0,0 +1,436 @@
+#include "ime_kern.h"
+#include "ime_precise.h"
+#include <math.h>
+#include <string.h>
+
+static int is_pow2(int n) { return n >= 1 && (n & (n - 1)) == 0; }
+
+int ime_decode_vlambda(int enc)
+{
+    if (enc == 0) return 0;
+    return 1 << (enc - 1);
+}
+
+int ime_emul_c(int L, int lambda)
+{
+    if (lambda <= 0) return 0;
+    if ((L % (lambda * lambda)) != 0) return 0;
+    int e = L / (lambda * lambda);
+    if (e == 1 || e == 2 || e == 4 || e == 8 || e == 16) return e;
+    return 0;
+}
+
+int ime_permissible(int L, int lambda)
+{
+    if (!is_pow2(L) || !is_pow2(lambda)) return 0;
+    int log = 0, t = L;
+    while (t > 1) { t >>= 1; log++; }
+    int cands[3];
+    int n = 0;
+    if ((log % 2) == 0) {
+        int root = 1;
+        while (root * root < L) root <<= 1;
+        if (root * root != L) return 0;
+        cands[n++] = root;
+        if (root / 2 >= 1) cands[n++] = root / 2;
+        if (root / 4 >= 1) cands[n++] = root / 4;
+    } else {
+        int half = L / 2;
+        int root = 1;
+        while (root * root < half) root <<= 1;
+        if (root * root != half) return 0;
+        cands[n++] = root;
+        if (root / 2 >= 1) cands[n++] = root / 2;
+    }
+    for (int i = 0; i < n; i++) if (cands[i] == lambda) return 1;
+    return 0;
+}
+
+int ime_decode_gemm(IMEGeom *g, int vlen, int sew, int lambda, int lmul, int W, int vl)
+{
+    memset(g, 0, sizeof(*g));
+    if (!(lmul == 1 || lmul == 2 || lmul == 4 || lmul == 8)) { g->illegal = 1; return -1; }
+    if (!(W == 1 || W == 2 || W == 4 || W == 8)) { g->illegal = 2; return -1; }
+    if (!is_pow2(vlen) || !is_pow2(sew) || sew < 8) { g->illegal = 3; return -1; }
+    int L = vlen / sew;
+    if (L * sew != vlen) { g->illegal = 4; return -1; }
+    if (!ime_permissible(L, lambda)) { g->illegal = 5; return -1; }
+    int EMUL_C = ime_emul_c(L, lambda);
+    if (!EMUL_C) { g->illegal = 6; return -1; }
+    int M = L / lambda;
+    int Keff = lambda * W * lmul;
+    int linesize = lambda * lmul;
+    if (linesize == 0 || (vl % linesize) != 0) { g->illegal = 7; return -1; }
+    int N = vl / linesize;
+    if (N < 0 || N > M) { g->illegal = 8; return -1; }
+    g->L = L; g->M = M; g->N = N; g->Nmax = M; g->Keff = Keff;
+    g->EMUL_C = EMUL_C; g->linesize = linesize;
+    g->EEW_C = sew; g->EEW_A = sew / W;
+    g->lambda = lambda; g->lmul = lmul; g->W = W;
+    g->vlen = vlen; g->sew = sew; g->vl = vl;
+    return 0;
+}
+
+int ime_tile_reg_idx(int i, int group_regs, int row_elems, int epr)
+{
+    int linesize = row_elems * group_regs;
+    int line = i / linesize;
+    int elem = i % linesize;
+    int regoff = elem / row_elems;
+    int elementoff = line * row_elems + (elem % row_elems);
+    return regoff * epr + elementoff;
+}
+
+static int64_t wrap_sew(int64_t x, int sew)
+{
+    if (sew >= 64) return x;
+    uint64_t m = (1ull << sew) - 1ull;
+    return (int64_t)((uint64_t)x & m);
+}
+
+static int64_t sext_n(int64_t x, int bits)
+{
+    uint64_t u = (uint64_t)x;
+    uint64_t sb = 1ull << (bits - 1);
+    uint64_t mask = (sb << 1) - 1ull;
+    u &= mask;
+    if (u & sb) u |= ~mask;
+    return (int64_t)u;
+}
+
+void ime_int_gemm(const int64_t *A, const int64_t *B, int64_t *C,
+                  const IMEGeom *g, int signed_a, int signed_b)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int inb = g->EEW_A, outb = g->EEW_C;
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < N; j++) {
+            int64_t acc = sext_n(C[i * Nmax + j], outb);
+            for (int k = 0; k < K; k++) {
+                int64_t a = A[i * K + k];
+                int64_t b = B[j * K + k];
+                a = signed_a ? sext_n(a, inb) : (int64_t)((uint64_t)a & ((1ull << inb) - 1ull));
+                b = signed_b ? sext_n(b, inb) : (int64_t)((uint64_t)b & ((1ull << inb) - 1ull));
+                acc += a * b;
+            }
+            C[i * Nmax + j] = wrap_sew(acc, outb);
+        }
+    }
+}
+
+static float bits_to_f32(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+static uint32_t f32_to_bits(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+static double bits_to_f64(uint64_t u) { double d; memcpy(&d, &u, 8); return d; }
+static uint64_t f64_to_bits(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+
+float ime_f16_to_f32(uint16_t h)
+{
+    int s = (h >> 15) & 1;
+    int e = (h >> 10) & 31;
+    int f = h & 1023;
+    uint32_t out;
+    if (e == 0) {
+        if (f == 0) out = (uint32_t)s << 31;
+        else {
+            e = 1;
+            while ((f & 0x400) == 0) { f <<= 1; e--; }
+            f &= 1023;
+            out = ((uint32_t)s << 31) | ((uint32_t)(e + 127 - 15) << 23) | ((uint32_t)f << 13);
+        }
+    } else if (e == 31) {
+        out = ((uint32_t)s << 31) | 0x7f800000u | ((uint32_t)f << 13);
+    } else {
+        out = ((uint32_t)s << 31) | ((uint32_t)(e + 127 - 15) << 23) | ((uint32_t)f << 13);
+    }
+    return bits_to_f32(out);
+}
+
+uint16_t ime_f32_to_f16(float x)
+{
+    uint32_t u = f32_to_bits(x);
+    int s = (u >> 31) & 1;
+    int e = (int)((u >> 23) & 255) - 127 + 15;
+    int f = (int)(u & 0x7fffff);
+    if ((u & 0x7fffffff) > 0x7f800000) return (uint16_t)((s << 15) | 0x7e00);
+    if (e <= 0) {
+        if (e < -10) return (uint16_t)(s << 15);
+        f |= 0x800000;
+        int t = 14 - e;
+        int round = (f >> (t - 1)) & 1;
+        f >>= t;
+        if (round) f++;
+        return (uint16_t)((s << 15) | f);
+    }
+    if (e >= 31) return (uint16_t)((s << 15) | 0x7c00);
+    int half = f >> 13;
+    int rem = f & 0x1fff;
+    if (rem > 0x1000 || (rem == 0x1000 && (half & 1))) half++;
+    if (half == 0x400) { half = 0; e++; }
+    if (e >= 31) return (uint16_t)((s << 15) | 0x7c00);
+    return (uint16_t)((s << 15) | (e << 10) | (half & 0x3ff));
+}
+
+float ime_e8m0_to_f32(uint8_t e)
+{
+    if (e == 255) return NAN;
+    return ldexpf(1.0f, (int)e - 127);
+}
+
+uint8_t ime_f32_to_e8m0(float x)
+{
+    if (!isfinite(x) || x <= 0) return 255;
+    int exp;
+    frexpf(x, &exp);
+    /* frexp: x = m * 2^exp with 0.5 <= m < 1, so true unbiased exp is exp-1 */
+    int e = exp - 1 + 127;
+    if (e < 0) return 0;
+    if (e > 254) return 254;
+    return (uint8_t)e;
+}
+
+static double load_fp(uint64_t bits, int eew)
+{
+    if (eew == 16) return (double)ime_f16_to_f32((uint16_t)bits);
+    if (eew == 32) return (double)bits_to_f32((uint32_t)bits);
+    return bits_to_f64(bits);
+}
+
+static uint64_t store_fp(double x, int eew)
+{
+    if (eew == 16) return ime_f32_to_f16((float)x);
+    if (eew == 32) return f32_to_bits((float)x);
+    return f64_to_bits(x);
+}
+
+void ime_fp_gemm(const uint64_t *A, const uint64_t *B, uint64_t *C, const IMEGeom *g)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int inb = g->EEW_A, outb = g->EEW_C;
+    if (ime_precise_fp && inb == 16 && outb == 16) {
+        for (int i = 0; i < M; i++) {
+            for (int j = 0; j < N; j++) {
+                uint16_t acc = (uint16_t)C[i * Nmax + j];
+                for (int k = 0; k < K; k++) {
+                    acc = ime_f16_fma_precise((uint16_t)A[i * K + k],
+                                              (uint16_t)B[j * K + k], acc);
+                }
+                C[i * Nmax + j] = acc;
+            }
+        }
+        return;
+    }
+    if (ime_precise_fp && inb == 8 && outb == 16) {
+        /* OFP8→f16 widening: treat A/B as e4m3, accum f16 */
+        for (int i = 0; i < M; i++) {
+            for (int j = 0; j < N; j++) {
+                uint16_t acc = (uint16_t)C[i * Nmax + j];
+                for (int k = 0; k < K; k++) {
+                    uint16_t a = (uint16_t)ime_fp_from_f32(
+                        ime_fp_to_f32((uint8_t)A[i * K + k], IME_FMT_E4M3), IME_FMT_F16);
+                    uint16_t b = (uint16_t)ime_fp_from_f32(
+                        ime_fp_to_f32((uint8_t)B[j * K + k], IME_FMT_E4M3), IME_FMT_F16);
+                    acc = ime_f16_fma_precise(a, b, acc);
+                }
+                C[i * Nmax + j] = acc;
+            }
+        }
+        return;
+    }
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < N; j++) {
+            double acc = load_fp(C[i * Nmax + j], outb);
+            for (int k = 0; k < K; k++) {
+                double a = load_fp(A[i * K + k], inb);
+                double b = load_fp(B[j * K + k], inb);
+                acc = fma(a, b, acc);
+            }
+            C[i * Nmax + j] = store_fp(acc, outb);
+        }
+    }
+}
+
+void ime_mx_gemm(const int64_t *A, const int64_t *B, int64_t *C,
+                 const uint8_t *sA, const uint8_t *sB,
+                 const IMEGeom *g, int block)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int inb = g->EEW_A, outb = g->EEW_C;
+    if (block <= 0) block = K < 32 ? K : 32;
+    int nblocks = (K + block - 1) / block;
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < N; j++) {
+            int64_t acc = sext_n(C[i * Nmax + j], outb);
+            for (int k = 0; k < K; k++) {
+                int bk = k / block;
+                float sa = ime_e8m0_to_f32(sA[i * nblocks + bk]);
+                float sb = ime_e8m0_to_f32(sB[j * nblocks + bk]);
+                int64_t a = sext_n(A[i * K + k], inb);
+                int64_t b = sext_n(B[j * K + k], inb);
+                double prod = (double)a * (double)sa * (double)b * (double)sb;
+                acc += (int64_t)llrint(prod);
+            }
+            C[i * Nmax + j] = wrap_sew(acc, outb);
+        }
+    }
+}
+
+uint64_t ime_load_elem(const uint8_t *vrf, int vlenb, int base, int idx, int eew)
+{
+    int epr = (vlenb * 8) / eew;
+    int reg = base + idx / epr;
+    int e = idx % epr;
+    const uint8_t *p = vrf + (size_t)reg * (size_t)vlenb + (size_t)e * (size_t)(eew / 8);
+    uint64_t v = 0;
+    memcpy(&v, p, (size_t)(eew / 8));
+    return v;
+}
+
+void ime_store_elem(uint8_t *vrf, int vlenb, int base, int idx, int eew, uint64_t val)
+{
+    int epr = (vlenb * 8) / eew;
+    int reg = base + idx / epr;
+    int e = idx % epr;
+    uint8_t *p = vrf + (size_t)reg * (size_t)vlenb + (size_t)e * (size_t)(eew / 8);
+    memcpy(p, &val, (size_t)(eew / 8));
+}
+
+void ime_vrf_int_gemm(uint8_t *vrf, int vlenb, const IMEGeom *g,
+                      int vd, int vs1, int vs2, int signed_a, int signed_b)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int eprA = g->vlen / g->EEW_A;
+    int eprC = g->vlen / g->EEW_C;
+    int64_t A[1024], B[1024], C[1024];
+    memset(A, 0, sizeof(A));
+    memset(B, 0, sizeof(B));
+    memset(C, 0, sizeof(C));
+    for (int i = 0; i < M; i++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(i * K + k, g->lmul, g->lambda * g->W, eprA);
+            A[i * K + k] = (int64_t)ime_load_elem(vrf, vlenb, vs1, idx, g->EEW_A);
+        }
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            C[i * Nmax + j] = (int64_t)ime_load_elem(vrf, vlenb, vd, idx, g->EEW_C);
+        }
+    }
+    for (int j = 0; j < N; j++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(j * K + k, g->lmul, g->lambda * g->W, eprA);
+            B[j * K + k] = (int64_t)ime_load_elem(vrf, vlenb, vs2, idx, g->EEW_A);
+        }
+    }
+    ime_int_gemm(A, B, C, g, signed_a, signed_b);
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            ime_store_elem(vrf, vlenb, vd, idx, g->EEW_C, (uint64_t)C[i * Nmax + j]);
+        }
+    }
+}
+
+void ime_vrf_fp_gemm(uint8_t *vrf, int vlenb, const IMEGeom *g, int vd, int vs1, int vs2)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int eprA = g->vlen / g->EEW_A;
+    int eprC = g->vlen / g->EEW_C;
+    uint64_t A[1024], B[1024], C[1024];
+    memset(A, 0, sizeof(A));
+    memset(B, 0, sizeof(B));
+    memset(C, 0, sizeof(C));
+    for (int i = 0; i < M; i++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(i * K + k, g->lmul, g->lambda * g->W, eprA);
+            A[i * K + k] = ime_load_elem(vrf, vlenb, vs1, idx, g->EEW_A);
+        }
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            C[i * Nmax + j] = ime_load_elem(vrf, vlenb, vd, idx, g->EEW_C);
+        }
+    }
+    for (int j = 0; j < N; j++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(j * K + k, g->lmul, g->lambda * g->W, eprA);
+            B[j * K + k] = ime_load_elem(vrf, vlenb, vs2, idx, g->EEW_A);
+        }
+    }
+    ime_fp_gemm(A, B, C, g);
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            ime_store_elem(vrf, vlenb, vd, idx, g->EEW_C, C[i * Nmax + j]);
+        }
+    }
+}
+
+void ime_vrf_mx_gemm(uint8_t *vrf, int vlenb, const IMEGeom *g, int vd, int vs1, int vs2, int block)
+{
+    int M = g->M, N = g->N, K = g->Keff, Nmax = g->Nmax;
+    int eprA = g->vlen / g->EEW_A;
+    int eprC = g->vlen / g->EEW_C;
+    if (block <= 0) block = K < 32 ? K : 32;
+    int nblocks = (K + block - 1) / block;
+    int64_t A[1024], B[1024], C[1024];
+    uint8_t sA[1024], sB[1024];
+    memset(A, 0, sizeof(A));
+    memset(B, 0, sizeof(B));
+    memset(C, 0, sizeof(C));
+    memset(sA, 127, sizeof(sA));
+    memset(sB, 127, sizeof(sB));
+    for (int i = 0; i < M; i++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(i * K + k, g->lmul, g->lambda * g->W, eprA);
+            A[i * K + k] = (int64_t)ime_load_elem(vrf, vlenb, vs1, idx, g->EEW_A);
+        }
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            C[i * Nmax + j] = (int64_t)ime_load_elem(vrf, vlenb, vd, idx, g->EEW_C);
+        }
+        for (int b = 0; b < nblocks; b++) sA[i * nblocks + b] = (uint8_t)ime_load_elem(vrf, vlenb, 0, i * nblocks + b, 8);
+    }
+    for (int j = 0; j < N; j++) {
+        for (int k = 0; k < K; k++) {
+            int idx = ime_tile_reg_idx(j * K + k, g->lmul, g->lambda * g->W, eprA);
+            B[j * K + k] = (int64_t)ime_load_elem(vrf, vlenb, vs2, idx, g->EEW_A);
+        }
+        for (int b = 0; b < nblocks; b++) sB[j * nblocks + b] = (uint8_t)ime_load_elem(vrf, vlenb, 0, 32 + j * nblocks + b, 8);
+    }
+    ime_mx_gemm(A, B, C, sA, sB, g, block);
+    for (int i = 0; i < M; i++) {
+        for (int j = 0; j < Nmax; j++) {
+            int idx = ime_tile_reg_idx(i * Nmax + j, g->EMUL_C, g->lambda, eprC);
+            ime_store_elem(vrf, vlenb, vd, idx, g->EEW_C, (uint64_t)C[i * Nmax + j]);
+        }
+    }
+}
+
+void ime_tile_move(uint8_t *vrf, int vlenb, uint8_t *mem, uint64_t mem_base,
+                   int vd, uint64_t rs1, uint64_t ld, int lambda, int lmul, int sew,
+                   int transpose, int store, uint64_t mem_size)
+{
+    int ebytes = sew / 8;
+    int epr = (vlenb * 8) / sew;
+    int linesize = lambda * lmul;
+    int M = epr / lambda;
+    int n = M * linesize;
+    uint64_t packed = transpose ? (uint64_t)M : (uint64_t)linesize;
+    if (ld == 0) ld = packed;
+    for (int i = 0; i < n; i++) {
+        int row = i / linesize;
+        int col = i % linesize;
+        uint64_t addr = transpose
+            ? rs1 + (uint64_t)col * ld * (uint64_t)ebytes + (uint64_t)row * (uint64_t)ebytes
+            : rs1 + (uint64_t)row * ld * (uint64_t)ebytes + (uint64_t)col * (uint64_t)ebytes;
+        if (addr < mem_base || addr + (uint64_t)ebytes > mem_base + mem_size) continue;
+        uint8_t *hp = mem + (addr - mem_base);
+        int idx = ime_tile_reg_idx(i, lmul, lambda, epr);
+        if (store) {
+            uint64_t v = ime_load_elem(vrf, vlenb, vd, idx, sew);
+            memcpy(hp, &v, (size_t)ebytes);
+        } else {
+            uint64_t v = 0;
+            memcpy(&v, hp, (size_t)ebytes);
+            ime_store_elem(vrf, vlenb, vd, idx, sew, v);
+        }
+    }
+}
