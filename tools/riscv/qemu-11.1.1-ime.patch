+bool qemu_plugin_raise_exception(uint64_t vaddr, uint64_t cause, uint64_t tval)
+{
+    const TCGCPUOps *ops;
+
+    g_assert(current_cpu);
+    g_assert(qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_RW_REGS ||
+             qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_RW_REGS_PC);
+
+    ops = current_cpu->cc->tcg_ops;
+    if (!ops->plugin_raise_exception) {
+        return false;
+    }
+    cpu_set_pc(current_cpu, vaddr);
+    ops->plugin_raise_exception(current_cpu, cause, tval);
+}
