+typedef struct {
+    int s, nan, inf, zero;
+    int e;          /* unbiased, valid if finite nonzero */
+    uint64_t m;     /* significand with implicit bit at bit `frac_bits` */
+} Unp;
+
+static Unp unpack(uint32_t bits, const Fmt *f)
+{
+    Unp u = {0};
+    int w = 1 + f->exp_bits + f->frac_bits;
+    bits &= (w >= 32) ? 0xffffffffu : ((1u << w) - 1u);
+    u.s = (int)((bits >> (f->exp_bits + f->frac_bits)) & 1);
+    int re = (int)((bits >> f->frac_bits) & ((1u << f->exp_bits) - 1u));
+    uint32_t frac = bits & ((1u << f->frac_bits) - 1u);
+    int emax = (1 << f->exp_bits) - 1;
+    if (f->nan_is_emax_fmax) {
+        if (re == emax && frac == ((1u << f->frac_bits) - 1u)) {
+            u.nan = 1;
+            return u;
+        }
+    } else if (f->has_inf && re == emax) {
+        u.nan = frac != 0;
+        u.inf = frac == 0;
+        return u;
+    }
+    if (re == 0) {
+        if (frac == 0) {
+            u.zero = 1;
+            return u;
+        }
+        /* subnormal */
+        u.e = 1 - f->bias;
+        u.m = frac;
+        while (u.m && (u.m & (1ull << f->frac_bits)) == 0) {
+            u.m <<= 1;
+            u.e--;
+        }
+        return u;
+    }
+    u.e = re - f->bias;
+    u.m = frac | (1ull << f->frac_bits);
+    return u;
+}
+
+static uint32_t pack(Unp u, const Fmt *f)
+{
+    int w = 1 + f->exp_bits + f->frac_bits;
+    uint32_t mask = (w >= 32) ? 0xffffffffu : ((1u << w) - 1u);
+    int emax = (1 << f->exp_bits) - 1;
+    if (u.nan) {
+        if (f->nan_is_emax_fmax)
+            return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits | ((1u << f->frac_bits) - 1u);
+        return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits | 1u;
+    }
+    if (u.inf) {
+        if (!f->has_inf) {
+            /* overflow → max finite */
+            return (uint32_t)(u.s << (w - 1)) | ((uint32_t)(emax - (f->nan_is_emax_fmax ? 0 : 0)) << f->frac_bits)
+                   | ((1u << f->frac_bits) - 1u - (f->nan_is_emax_fmax ? 1u : 0));
+        }
+        return (uint32_t)(u.s << (w - 1)) | (uint32_t)emax << f->frac_bits;
+    }
+    if (u.zero || u.m == 0)
+        return (uint32_t)u.s << (w - 1);
+    /* normalize */
+    while (u.m && u.m < (1ull << f->frac_bits)) {
+        u.m <<= 1;
+        u.e--;
+    }
+    while (u.m >= (2ull << f->frac_bits)) {
+        u.m >>= 1;
+        u.e++;
+    }
+    int re = u.e + f->bias;
+    if (re <= 0) {
+        /* subnormal / underflow */
+        int shift = 1 - f->bias - u.e;
+        if (shift > f->frac_bits + 2) return (uint32_t)u.s << (w - 1);
+        uint64_t sig = u.m;
+        uint64_t round = 0;
+        if (shift > 0) {
+            round = (sig >> (shift - 1)) & 1;
+            uint64_t sticky = sig & ((1ull << (shift - 1)) - 1ull);
+            sig >>= shift;
+            if (round && (sticky || (sig & 1))) sig++;
+        }
+        if (sig == 0) return (uint32_t)u.s << (w - 1);
+        return ((uint32_t)u.s << (w - 1)) | (uint32_t)(sig & ((1u << f->frac_bits) - 1u));
+    }
+    if (re >= emax) {
+        if (!f->has_inf) {
+            uint32_t maxf = ((1u << f->frac_bits) - 1u) - (f->nan_is_emax_fmax ? 1u : 0);
+            return ((uint32_t)u.s << (w - 1)) | ((uint32_t)(emax - (f->nan_is_emax_fmax ? 0 : 0)) << f->frac_bits) | maxf;
+        }
+        return ((uint32_t)u.s << (w - 1)) | ((uint32_t)emax << f->frac_bits);
+    }
+    uint32_t frac = (uint32_t)(u.m & ((1ull << f->frac_bits) - 1ull));
+    return ((uint32_t)u.s << (w - 1)) | ((uint32_t)re << f->frac_bits) | frac;
+}
