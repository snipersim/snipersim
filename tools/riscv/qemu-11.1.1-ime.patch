+/*
+ * CSRs a plugin backs (qemu_plugin_register_sysreg_cb): an address the
+ * target does not implement gets accessors that call the plugin.  The
+ * ordinary access rules still apply (riscv_csrrw_check: privilege, the
+ * read-only ranges), only the existence check is satisfied.
+ */
+static struct {
+    uint64_t (*read)(unsigned int, unsigned int, void *);
+    void (*write)(unsigned int, unsigned int, uint64_t, void *);
+    void *udata;
+} plugin_csrs[CSR_TABLE_SIZE];
+
+static RISCVException plugin_csr_predicate(CPURISCVState *env, int csrno)
+{
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException plugin_csr_read(CPURISCVState *env, int csrno,
+                                      target_ulong *val)
+{
+    *val = plugin_csrs[csrno].read(env_cpu(env)->cpu_index, csrno,
+                                   plugin_csrs[csrno].udata);
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException plugin_csr_write(CPURISCVState *env, int csrno,
+                                       target_ulong val, uintptr_t ra)
+{
+    plugin_csrs[csrno].write(env_cpu(env)->cpu_index, csrno, val,
+                             plugin_csrs[csrno].udata);
+    return RISCV_EXCP_NONE;
+}
+
+bool riscv_plugin_csr_claim(unsigned int csrno,
+                            uint64_t (*read)(unsigned int, unsigned int, void *),
+                            void (*write)(unsigned int, unsigned int, uint64_t, void *),
+                            void *udata)
+{
+    riscv_csr_operations ops = { .name = "plugin", .predicate = plugin_csr_predicate,
+                                 .read = plugin_csr_read,
+                                 .write = write ? plugin_csr_write : NULL };
+
+    if (csrno >= CSR_TABLE_SIZE || csr_ops[csrno].predicate || !read) {
+        return false;
+    }
+    plugin_csrs[csrno].read = read;
+    plugin_csrs[csrno].write = write;
+    plugin_csrs[csrno].udata = udata;
+    csr_ops[csrno] = ops;
+    return true;
+}
