+    return (uint8_t)ime_fma_precise(a, b, c, IME_FMT_E2M1);
+}
+
+float ime_fp_to_f32(uint32_t bits, ImeFpFmt fmt)
+{
+    const Fmt *f = &FMTS[fmt];
+    Unp u = unpack(bits, f);
+    if (u.nan) return NAN;
+    if (u.inf) return u.s ? -INFINITY : INFINITY;
+    if (u.zero) return u.s ? -0.0f : 0.0f;
+    float mag = ldexpf((float)u.m / (float)(1 << f->frac_bits), u.e);
+    return u.s ? -mag : mag;
+}
+
+uint32_t ime_fp_from_f32(float x, ImeFpFmt fmt)
+{
+    const Fmt *f = &FMTS[fmt];
+    Unp u = {0};
+    if (isnan(x)) {
+        u.nan = 1;
+        return pack(u, f);
+    }
+    if (isinf(x)) {
+        u.inf = 1;
+        u.s = signbit(x) ? 1 : 0;
+        return pack(u, f);
+    }
+    if (x == 0.0f) {
+        u.zero = 1;
+        u.s = signbit(x) ? 1 : 0;
+        return pack(u, f);
+    }
+    u.s = signbit(x) ? 1 : 0;
+    x = fabsf(x);
+    int e;
+    float m = frexpf(x, &e); /* 0.5 <= m < 1, x = m * 2^e */
+    /* want implicit 1 at frac_bits: 1.frac * 2^(e-1) */
+    u.e = e - 1;
+    u.m = (uint64_t)llrint((double)m * (double)(1ull << (f->frac_bits + 1)));
+    if (u.m >= (2ull << f->frac_bits)) {
+        u.m >>= 1;
+        u.e++;
+    }
+    return pack(u, f);
+}
