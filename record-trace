# QEMU: the plugin front end (frontend/qemu-plugin), for guests of another
# architecture or a whole machine.  --frontend=qemu is user mode: the guest
# program's own ELF header says which QEMU runs it.  --frontend=qemu-system-<arch>
# is full system: the command line is QEMU's machine options (-M, -kernel, ...),
# and the trace is written to files, since a whole machine has no response
# channel to block on.  Each QEMU is a dependency linked into the tree
# (deps/manifest.json); the variable named with each points at another, the
# same ones testing/test_qemu.py reads.
QEMU_USER = { 62:  ('x86_64',  'qemu/build/qemu-x86_64',          'SNIPER_QEMU_X86_64'),  # EM_X86_64
              183: ('aarch64', 'qemu-aarch64/build/qemu-aarch64',  'SNIPER_QEMU_AARCH64'), # EM_AARCH64
              243: ('riscv64', 'qemu-riscv/build/qemu-riscv64',    'SNIPER_QEMU_RISCV') }  # EM_RISCV
RISCV_CPU_DEFAULT = 'max,vlen=128,x-zvvmm=on,x-zvvfmm=on,x-zvvmtls=on'
QEMU_SYSTEM = { 'x86_64':  ('qemu/build/qemu-system-x86_64',               'SNIPER_QEMU_SYSTEM_X86_64'),
                'riscv64': ('qemu-riscv-system/build/qemu-system-riscv64', 'SNIPER_QEMU_RISCV_SYSTEM') }

def elf_machine(path):
  try:
    with open(path, 'rb') as f:
      h = f.read(20)
  except IOError:
    return None
  if len(h) < 20 or h[:4] != b'\x7fELF':
    return None
  return int.from_bytes(h[18:20], 'little' if h[5] == 1 else 'big')

def qemu_refuse(what):
  print('[RECORD-TRACE] Error: %s is not available with the QEMU front end.' % what, file=sys.stderr)
  sys.exit(1)

def qemu_binary(arch, relpath, var):
  path = os.environ.get(var) or os.path.join(HOME, relpath)
  if not os.access(path, os.X_OK):
    print('[RECORD-TRACE] Error: no QEMU for %s at %s.\n'
          '  Build it with make QEMU=ON (and ARM=ON for aarch64, RISCV_IME=ON for riscv64),\n'
          '  or point $%s at a QEMU built with --enable-plugins.' % (arch, path, var), file=sys.stderr)
    sys.exit(1)
  return path

def qemu_command():
  system = frontend.startswith('qemu-system')
  # The options this front end cannot take were refused by the table above.
  plugin = os.path.join(BUILD_DIR, 'lib', 'libsniper-qemu.so')
  if not os.path.exists(plugin):
    print('[RECORD-TRACE] Error: %s not built (make QEMU=ON)' % plugin, file=sys.stderr)
    sys.exit(1)
  popts = [ 'output=%s' % outputfile, 'app=%d' % siftcountoffset ]
  if use_roi:
    popts.append('roi=1')
  if enable_pacsim:
    # The sampler lives in the plugin (frontend/qemu-plugin/pacsim_qemu.cc);
    # it needs the live channel and the ROI, which run-sniper --pacsim gives.
    if system or not useresponsefiles or not use_roi:
      qemu_refuse('Pac-Sim sampling without a live channel and an ROI (run-sniper --pacsim --roi, user mode)')
    require_pacsim(plugin)
    popts += [ 'pacsim=1', 'pacsim-dir=%s' % outputdir ]
    if cmdline and os.path.isfile(cmdline[0]):
      popts.append('pacsim-syms=%s' % os.path.abspath(cmdline[0]))   # the synchronisation points, from the ELF
  # Recorder knobs given as --trace-args (-sniper:name value) are the plugin's
  # name=value options, so one run-sniper line serves both front ends.
  toks = extra_tool_args.split()
  i = 0
  while i < len(toks):
    if toks[i].startswith('-sniper:'):
      name = toks[i][len('-sniper:'):]
      if i + 1 < len(toks) and not toks[i + 1].startswith('-'):
        popts.append('%s=%s' % (name, toks[i + 1])); i += 2
      else:
        popts.append(name); i += 1
    else:
      popts.append(toks[i]); i += 1
  if not track_smc:
    popts.append('smc=0')
  if verbose:
    popts.append('verbose=on')
  qopts = []
  # The guest's virtual address space, in bits, for QEMU user mode: QEMU lays a
  # riscv64 guest out over 48 bits (Sv48's) by default, while the riscv
  # configurations model Sv39, whose user half is 38 bits -- an address above
  # it the simulator refuses rather than aliases.  So RISC-V guests are
  # confined with -R to 2^(bits-1) unless --qemu-va-bits says otherwise (48
  # for Sv48 with a 4-level table, --frontend-option='-R ...' to set it by
  # hand); AArch64 and x86-64 fit their 48-bit tables as QEMU lays them out.
  for o in frontend_options:
    qopts += shlex.split(o)
  if system:
    arch = frontend[len('qemu-system-'):] or 'x86_64'
    if arch not in QEMU_SYSTEM:
      print('[RECORD-TRACE] Error: no full-system QEMU for %s (have: %s)' % (arch, ', '.join(sorted(QEMU_SYSTEM))), file=sys.stderr)
      sys.exit(1)
    if useresponsefiles:
      qemu_refuse('a live full-system run (response files); record, then simulate the traces')
    qemu = qemu_binary(arch, *QEMU_SYSTEM[arch])
    argv = [ qemu ] + qopts + [ '-plugin', ','.join([ plugin ] + popts) ] + cmdline
  else:
    if not cmdline:
      print('[RECORD-TRACE] Error: no guest program given', file=sys.stderr)
      sys.exit(1)
    prog = cmdline[0] if os.sep in cmdline[0] else (shutil.which(cmdline[0]) or cmdline[0])
    machine = elf_machine(prog)
    if machine not in QEMU_USER:
      print('[RECORD-TRACE] Error: %s is not an x86-64, AArch64 or RISC-V executable' % prog, file=sys.stderr)
      sys.exit(1)
    arch, relpath, var = QEMU_USER[machine]
    qemu = qemu_binary(arch, relpath, var)
    if useresponsefiles:
      popts.append('response=on')       # live: Sniper paces the guest and answers its magic
    if arch == 'aarch64' and '-cpu' not in qopts:
      # Every extension QEMU has, with SVE's vector length at 128 bits: the
      # cortex configurations' perf_model/core/arm/sve_bytes = 16, the width
      # the decoder gives an SVE load or store (QEMU's own default is 512).
      qopts = [ '-cpu', 'max,sve-default-vector-length=%d' % SVE_BYTES_DEFAULT ] + qopts
    if arch == 'x86_64' and '-cpu' not in qopts:
      # QEMU's default x86-64 model (qemu64) has no AVX: a binary built with
      # -march=native died with SIGILL.  max is what the other two get.
      qopts = [ '-cpu', 'max' ] + qopts
    if arch == 'riscv64' and '-R' not in qopts and qemu_va_bits != 48:
      qopts = [ '-R', '0x%x' % (1 << (qemu_va_bits - 1)) ] + qopts
    if arch == 'riscv64' and '-cpu' not in qopts:
      # The vector and matrix units (RVV, the IME and AME extensions the
      # qemu-riscv-ime dependency adds) with the vector length the riscv
      # configuration models; $SNIPER_QEMU_RISCV_IME_CPU names another, and a
      # QEMU without the x- properties takes --frontend-option='-cpu max'.
      qopts = [ '-cpu', os.environ.get('SNIPER_QEMU_RISCV_IME_CPU', RISCV_CPU_DEFAULT) ] + qopts
    argv = [ qemu ] + qopts + [ '-plugin', ','.join([ plugin ] + popts), '--', prog ] + cmdline[1:]
  print('[RECORD-TRACE] Using the QEMU frontend (%s)' % os.path.basename(qemu))
  return ' '.join(shlex.quote(a) for a in argv)

SVE_BYTES_DEFAULT = 16   # bytes; matches perf_model/core/arm/sve_bytes in the cortex configurations

value_roi = use_roi and 1 or 0
value_roi_mpi = roi_mpi and 1 or 0
value_pa = use_pa and 1 or 0
value_routine_tracing = use_routine_tracing and 1 or 0
value_verbose = verbose and 1 or 0
value_vma = log_vma and 1 or 0
extra_tool_args = ' '.join(extra_tool_args)
if frontend:
  if frontend == 'dr':
    print('[RECORD-TRACE] Using DynamoRIO frontend')
    DRRUN = '%(dynamorio_home)s/bin64/drrun' % locals()
    DR_frontendlib = '%(BUILD_DIR)s/lib/libdr-frontend.so' % locals()
    DR_libpath = 'LD_LIBRARY_PATH=$LD_LIBRARY_PATH:%(dynamorio_home)s/lib64/debug' % locals()
    dr_args = '-thread_private'
    bool_args = ''
    # Code rewritten in place: tracked unless --no-smc.  The DynamoRIO front
    # end has no strict per-instruction mode; --smc gets the tracking.
    if not track_smc:
       bool_args += '-smc 0 '
    if value_pa == 1:
       bool_args += '-pa '
    if verbose:
       bool_args += '-verbose '            # a flag: '-verbose 1' made the client abort on '1'
       dr_args += ' -loglevel 1'
    else:
       dr_args += ' -loglevel 0 -stderr_mask 0'
    cmd = '%(DR_libpath)s %(DRRUN)s %(dr_args)s -c %(DR_frontendlib)s -roi %(value_roi)d -vma %(value_vma)d -f %(fastforward)d -d %(detailed)d -b %(blocksize)d -o %(outputfile)s -e %(syscallemulation)d -s %(siftcountoffset)d -r %(useresponsefiles)d -stop %(stop_address)d %(bool_args)s %(extra_tool_args)s  -- ' % locals() + ' '.join(cmdline)
  elif frontend == 'qemu' or frontend.startswith('qemu-system'):
    cmd = qemu_command()
    # The caller's environment, not Pin's: setup_env puts the Pin kit's
    # libraries first, and the plugin then loads the kit's libxed, which
    # needs Pin's own C runtime (libpincrt.so) and fails to load.
    env = dict(os.environ)
  else:
    print('[RECORD-TRACE] Error: frontend %s not recognized' % frontend)
    sys.exit(1)
else:
  print('[RECORD-TRACE] Using the SDE frontend (sift/recorder)')
  if enable_pacsim:
    require_pacsim('%(HOME)s/sift/recorder/obj-%(arch)s/sde_sift_recorder.so' % locals())
  # Pin's own log (written on a Pin-level failure) goes next to the trace,
  # not into the working directory, where two recordings running at once
  # from one tree would delete and copy each other's; run-sniper collects it
  # from the trace's directory.  SDE sets Pin's logfile knob itself, so this
  # is SDE's option for it, not Pin's.
  pinlog = os.path.join(os.path.dirname(os.path.abspath(outputfile)), 'pin.log')
  cmd = '%(sde_home)s/sde64 %(sde_arch)s -pin-log-file %(pinlog)s %(pinoptions)s -t64 %(HOME)s/sift/recorder/obj-%(arch)s/sde_sift_recorder.so -sniper:verbose %(value_verbose)d -sniper:debug %(gdb_screen)d -sniper:roi %(value_roi)d -sniper:vma %(value_vma)d -sniper:roi-mpi %(value_roi_mpi)d -sniper:f %(fastforward)d -sniper:d %(detailed)d -sniper:b %(blocksize)d -sniper:o %(outputfile)s -sniper:e %(syscallemulation)d  -sniper:s %(siftcountoffset)d -sniper:r %(useresponsefiles)d  -sniper:pa %(value_pa)d -sniper:rtntrace  %(value_routine_tracing)d -sniper:stop %(stop_address)d %(pinballoptions)s %(extra_tool_args)s %(extrae)s' % locals() + pacsim_knob('%(HOME)s/sift/recorder/obj-%(arch)s/sde_sift_recorder.so' % locals()) + smc_knob() + ' -- ' + ' '.join(cmdline)

if verbose:
  print('[SIFT_RECORDER]', 'Running', cmd)
  sys.stdout.flush()
if use_gdb:
  debugpin.execute_gdb(cmd = cmd, env = env, pin_home = pin_home, arch = arch, quiet = True, wait = gdb_wait, quit = gdb_quit)
# close_fds=False: an MPI rank inherits its process manager's socket as an
# open file descriptor, named in PMI_FD, and Python closes every descriptor
# above 2 by default.  With it closed the rank cannot talk to mpiexec:
#
#   [cli_0]: PMIU_write error; fd=9 buf=:cmd=init pmi_version=1
#   [cli_0]: PMIU_write error; fd=9 buf=:cmd=abort exitcode=-1 message=PMI_Init failed
#
# The environment survived already -- setup_env copies os.environ -- so the
# variable pointing at the descriptor arrived while the descriptor itself did
# not.
subproc = subprocess.Popen([ 'bash', '-c', cmd ], env = env, close_fds = False)
if use_pid and pid_continue:
  import signal
  while procStatus(use_pid).strip() != 'T':
    usleep(100)
  os.kill(use_pid, signal.SIGCONT)
pid, rc, usage = os.wait4(subproc.pid, 0)

# The recorder's exit status is ours.  This line was missing: rc was collected
# and the script fell off the end, exiting 0 whatever had happened.
sys.exit(run_sniper.decode_wait_status(rc, 'SIFT_RECORDER'))
