# Does this recorder actually implement Pac-Sim?
#
# The knob is a string literal in the built tool, so its presence is a direct
# answer rather than an inference from which files happen to be on disk.  This
# is checked instead of assumed because the failure is silent otherwise: a
# recorder without Pac-Sim ignores an unknown knob family, traces the whole
# application unsampled, and produces results that look ordinary and are not
# the methodology the user asked for.
PACSIM_KNOB = b'sniper:pacsim'
PACSIM_KNOB_QEMU = b'pacsim-region-size'   # the plugin spells its options without the prefix

# Where the recorder writes its per-region data, the file the analysis scripts
# read.  MTNG was Pac-Sim's earlier name; the knob is spelled both ways here so
# that whichever a ported recorder defines, the directory still gets set.
#
# The historical knob defaulted to ".", so the data landed in whatever directory
# the user happened to run from while run-sniper looked for it in the output
# directory -- the two never met.  Pointing it at the output directory is what
# makes the estimate findable.
DIR_KNOBS = (b'sniper:pacsim-dir', b'sniper:mtng-dir')

def recorder_has_pacsim(tool_path):
  return has_knob(tool_path, PACSIM_KNOB_QEMU if tool_path.endswith('.so') else PACSIM_KNOB)

def has_knob(tool_path, knob):
  try:
    with open(tool_path, 'rb') as f:
      return knob in f.read()
  except IOError:
    return False


def smc_knob():
  # Code rewritten in place.  By default the recorder notices it when Pin
  # re-translates the code and sends the changed pages again; --smc is the
  # strict mode, where every instruction carries its bytes (slower), and
  # --no-smc sends each code page once, as releases before 9.0 did.
  if enable_smc:
    return ' -sniper:smc 1'
  return '' if track_smc else ' -sniper:smc-track 0'


def pacsim_knob(tool_path):
  # Emitted only when enabled.  Pin treats an unrecognised knob as fatal, so a
  # recorder built without Pac-Sim must not be handed the knob at all -- not
  # even set to zero, which would break every ordinary trace.
  if not enable_pacsim:
    return ''
  opts = ' -%s 1' % PACSIM_KNOB.decode()
  # Asked for rather than assumed, for the same reason: a port that spells this
  # knob differently should lose the output-directory default, not fail to run.
  for knob in DIR_KNOBS:
    if has_knob(tool_path, knob):
      opts += ' -%s %s' % (knob.decode(), outputdir)
      break
  return opts

def require_pacsim(tool_path):
  if recorder_has_pacsim(tool_path):
    return
  print("""record-trace: --pacsim was requested, but this SIFT recorder does not implement it.

  recorder: %s
  expected: a KNOB named "%s"

The recorder in the tree carries Pac-Sim (sift/recorder/pacsim.cc); a
recorder without the knob is an old or a differently configured build.
Running without it would trace the application unsampled and report timings
that are not Pac-Sim's, so this is an error rather than a warning.""" % (
      tool_path, PACSIM_KNOB.decode()), file=sys.stderr)
  sys.exit(1)

