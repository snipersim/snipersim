# What the runtime tools need to know about this build.
#
# run-sniper, record-trace and the test makefiles read config/sniper.py to find
# the kits and the simulator binary.  The Makefile wrote it to one fixed place in
# the source tree, so however many configurations you could build, only one could
# describe itself to the tools -- which is why parallel build directories were
# not actually usable.
#
# Each build directory writes its own, and run-sniper resolves which to use from
# --build-dir, $SNIPER_BUILD_DIR, build/default, or the source tree.

# Paths are written relative to the source root when they are inside it, which is
# what the Makefile's makerelativepath.py did, so a tree can be moved.  Anything
# outside stays absolute; os.path.join on the reader's side handles both.
function(_sniper_relative_to_root path out)
  if(NOT path)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(_abs "${path}" ABSOLUTE)
  file(RELATIVE_PATH _rel "${CMAKE_SOURCE_DIR}" "${_abs}")
  if(_rel MATCHES "^\\.\\.")
    set(${out} "${_abs}" PARENT_SCOPE)
  else()
    set(${out} "${_rel}" PARENT_SCOPE)
  endif()
endfunction()

if(SNIPER_FRONTEND STREQUAL "sde")
  set(_sde_home "${CMAKE_SOURCE_DIR}/sde_kit")
  set(_pin_home "${CMAKE_SOURCE_DIR}/sde_kit/pinkit")
elseif(SNIPER_FRONTEND STREQUAL "none")
  set(_sde_home "")
  set(_pin_home "")
else()
  set(_sde_home "")
  set(_pin_home "${CMAKE_SOURCE_DIR}/pin_kit")
endif()

_sniper_relative_to_root("${_sde_home}" SNIPER_CFG_SDE_HOME)
_sniper_relative_to_root("${_pin_home}" SNIPER_CFG_PIN_HOME)
_sniper_relative_to_root("${SNIPER_XED_HOME}" SNIPER_CFG_XED_HOME)
if(SNIPER_ENABLE_TORCH)
  _sniper_relative_to_root("${SNIPER_TORCH_HOME}" SNIPER_CFG_TORCH_HOME)
else()
  set(SNIPER_CFG_TORCH_HOME "")
endif()
if(SNIPER_ENABLE_DYNAMORIO)
  _sniper_relative_to_root("${CMAKE_SOURCE_DIR}/dynamorio/build" SNIPER_CFG_DR_HOME)
else()
  set(SNIPER_CFG_DR_HOME "")
endif()

# Provenance.  Results previously carried only the Sniper revision; which SDE,
# XED and libtorch produced a number was unanswerable.
execute_process(
  COMMAND git -C "${CMAKE_SOURCE_DIR}" rev-parse HEAD
  OUTPUT_VARIABLE SNIPER_CFG_GIT_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET RESULT_VARIABLE _git_rc)
if(NOT _git_rc EQUAL 0)
  set(SNIPER_CFG_GIT_REVISION "")
endif()

set(SNIPER_CFG_TARGET intel64)

configure_file(
  "${CMAKE_CURRENT_LIST_DIR}/sniper.py.in"
  "${CMAKE_BINARY_DIR}/config/sniper.py"
  @ONLY)

# buildconf.sh / buildconf.makefile, used to compile benchmark applications
# against this build (see COMPILATION).  Generated by the existing script, which
# writes into config/ relative to its working directory.
add_custom_target(sniper_buildconf ALL
  COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/config"
  COMMAND "${Python3_EXECUTABLE}"
          "${CMAKE_SOURCE_DIR}/tools/makebuildscripts.py"
          "${CMAKE_SOURCE_DIR}" "${_sde_home}" "${_pin_home}"
          "${CMAKE_SOURCE_DIR}/dynamorio/build"
          "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${SNIPER_CFG_TARGET}"
  WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
  COMMENT "Generating config/buildconf.* for this build directory"
  VERBATIM)
