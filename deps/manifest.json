{
  "_comment": [
    "Every external dependency Sniper fetches, declared in one place.",
    "",
    "Previously these were ~100 lines of ad-hoc wget and git rules scattered",
    "through the top-level Makefile, with no checksums, no inventory, and a",
    "private copy downloaded into every checkout.",
    "",
    "'sha256' is verified after download.  null means not yet pinned; run",
    "  deps/sniper-deps pin <name>",
    "to download once and record the digest.",
    "",
    "'when' lists build options that must be enabled for the dependency to be",
    "needed.  An empty list means always.  'frontend:sde' matches the frontend",
    "selection; a bare name like 'torch' matches an enabled feature.",
    "",
    "'install_path' is where the source tree expects to find it.  The fetcher",
    "unpacks into a shared content-addressed cache and symlinks this path at it,",
    "so several checkouts share one copy and the existing makefiles keep working."
  ],
  "version": 1,
  "dependencies": {
    "sde": {
      "kind": "tarball",
      "version": "10.13.1-2026-07-28",
      "url": "https://snipersim.org/packages/sde-external-10.13.1-2026-07-28-lin.tar.xz",
      "sha256": "94e97d623fec54385686e1e7ba65ebc9941748c05ee451423948334892bf2b50",
      "strip_components": 1,
      "install_path": "sde_kit",
      "when": [
        "frontend:sde"
      ],
      "marker": "intel64/pin_lib/libpindwarf.so",
      "post_prune": [
        "pinkit/source/tools/InstLib"
      ],
      "description": "Intel Software Development Emulator; provides the Pin kit used by the SIFT recorder"
    },
    "pinplay-tools": {
      "kind": "git",
      "url": "https://github.com/intel/pinplay-tools",
      "rev": "17ccab4f1326fdef96a2621c3c7e374ee26c160a",
      "install_path": "pinplay-tools",
      "when": [
        "frontend:sde"
      ],
      "marker": "pinplay-scripts",
      "description": "PinPlay helper scripts used by the SDE recorder build. Kept at the top level rather than under sde_kit/, which is a symlink into the shared cache"
    },
    "pin": {
      "kind": "tarball",
      "version": "3.31-98869-gfa6f126a8",
      "url": "https://snipersim.org/packages/pin-external-3.31-98869-gfa6f126a8-gcc-linux.tar.gz",
      "sha256": "82216144e3df768f0203b671ff48605314f13266903eb42dac01b91310eba956",
      "strip_components": 1,
      "install_path": "pin_kit",
      "when": [
        "frontend:pin"
      ],
      "marker": "intel64/lib/libpindwarf.so",
      "description": "Intel Pin kit, for the plain-Pin frontend"
    },
    "pinplay": {
      "kind": "tarball",
      "version": "3.11-pin-3.11-97998-g7ecce2dac",
      "url": "https://snipersim.org/packages/pinplay-dcfg-3.11-pin-3.11-97998-g7ecce2dac-gcc-linux.tar.bz2",
      "sha256": "d584efb868217fea1ca2796ad5f41eb61679c2769fc859dd299a6fd5bf175f45",
      "strip_components": 1,
      "install_path": "pin_kit",
      "when": [
        "frontend:pinplay"
      ],
      "marker": "intel64/lib-ext/libpin3dwarf.so",
      "description": "PinPlay-enabled Pin kit"
    },
    "xed": {
      "kind": "git",
      "url": "https://github.com/intelxed/xed.git",
      "rev": "b86dd5014463d954bc8898d2376b14852d26facd",
      "install_path": "xed",
      "when": [],
      "marker": "src/common/xed-init.c",
      "description": "Intel X86 Encoder Decoder; built into xed_kit by mfile.py"
    },
    "mbuild": {
      "kind": "git",
      "url": "https://github.com/intelxed/mbuild.git",
      "rev": "f32bc9b31f9fc5a0be3dc88cd2086b70270295ab",
      "install_path": "mbuild",
      "when": [],
      "marker": "mbuild/arar.py",
      "description": "Build system XED's mfile.py requires"
    },
    "xed-kit": {
      "kind": "build",
      "from": [
        "xed",
        "mbuild"
      ],
      "install_path": "xed_kit",
      "when": [],
      "marker": "include/xed/xed-iclass-enum.h",
      "workdir": "{dep:xed}",
      "env": {
        "PYTHONPATH": "{dep:mbuild}",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "command": [
        "{python}",
        "./mfile.py",
        "--silent",
        "--jobs",
        "{jobs}",
        "--extra-flags=-fPIC",
        "--shared",
        "--build-dir",
        "{build}",
        "--install-dir",
        "{install}",
        "install"
      ],
      "description": "XED built into a kit; the decoder and the recorder link against this, not the source"
    },
    "mcpat": {
      "kind": "tarball",
      "version": "1.0",
      "url": "https://snipersim.org/packages/mcpat-1.0.tgz",
      "sha256": "1e230fc90c1621833724b27f57f5170d2cf33c1e9ec50cc33b9ee71902f21128",
      "strip_components": 0,
      "install_path": "mcpat",
      "when": [
        "mcpat"
      ],
      "marker": "mcpat-1.0",
      "description": "Power and area model. Was the one dependency pinned to no version at all"
    },
    "libtorch": {
      "kind": "tarball",
      "version": "2.5.0",
      "url": "https://snipersim.org/packages/libtorch-shared-with-deps-2.5.0-cpu.tar.gz",
      "sha256": "006c5eaa2026331235c4ef88b5b5bca771b6a8e1051439f885d67b10599ecdc4",
      "strip_components": 1,
      "install_path": "libtorch",
      "when": [
        "torch"
      ],
      "marker": "lib/libtorch.so",
      "abi": "pre-cxx11",
      "description": "CPU libtorch for the neural-net branch predictor. This is the pre-cxx11-ABI build, which is why the whole tree is compiled -D_GLIBCXX_USE_CXX11_ABI=0"
    },
    "capstone": {
      "kind": "git",
      "url": "https://github.com/aquynh/capstone.git",
      "rev": "f9c6a90489be7b3637ff1c7298e45efafe7cf1b9",
      "install_path": "capstone-src",
      "when": [
        "arm",
        "dynamorio"
      ],
      "when_any": true,
      "marker": "arch/AArch64/ARMMappingInsnOp.inc",
      "description": "Disassembly framework source; built into capstone/ by capstone-build"
    },
    "capstone-build": {
      "kind": "build",
      "from": [
        "capstone"
      ],
      "copy_from": "capstone",
      "install_path": "capstone",
      "when": [
        "arm",
        "dynamorio"
      ],
      "when_any": true,
      "marker": "libcapstone.a",
      "workdir": "{install}",
      "env": {},
      "command": [
        "./make.sh"
      ],
      "description": "Capstone built in place; the ARM decoder links libcapstone.a from here"
    },
    "dynamorio": {
      "kind": "git",
      "url": "https://github.com/DynamoRIO/dynamorio.git",
      "rev": "246ddb28e7848b2d09d2b9909f99a6da9b2ce35e",
      "recursive": true,
      "install_path": "dynamorio-src",
      "when": [
        "dynamorio"
      ],
      "marker": "CMakeLists.txt",
      "description": "DynamoRIO source; built into dynamorio/ by dynamorio-build"
    },
    "dynamorio-build": {
      "kind": "build",
      "from": [
        "dynamorio"
      ],
      "copy_from": "dynamorio",
      "install_path": "dynamorio",
      "when": [
        "dynamorio"
      ],
      "marker": "build/bin64/drrun",
      "workdir": "{install}",
      "env": {},
      "command": [
        "sh",
        "-c",
        "mkdir -p build && cd build && cmake -DDEBUG=ON .. && make -j{jobs}"
      ],
      "description": "DynamoRIO built in place; DynamoRIO_DIR points at dynamorio/build/cmake"
    },
    "qemu": {
      "kind": "git",
      "url": "https://gitlab.com/qemu-project/qemu.git",
      "rev": "c3d48b7d1e89604920e5b81b91140c2ad39a1943",
      "tag": "v11.1.1",
      "install_path": "qemu-src",
      "when": [
        "qemu",
        "riscv-ime"
      ],
      "marker": "include/plugins/qemu-plugin.h",
      "description": "QEMU 11.1.1 source; plugin API v7. Cloned shallow at the tag, verified against rev",
      "when_any": true
    },
    "qemu-build": {
      "kind": "build",
      "from": [
        "qemu"
      ],
      "copy_from": "qemu",
      "install_path": "qemu",
      "when": [
        "qemu"
      ],
      "marker": "build/qemu-system-x86_64",
      "workdir": "{install}",
      "env": {},
      "command": [
        "sh",
        "-c",
        "mkdir -p build && cd build && ../configure --enable-plugins --target-list=x86_64-softmmu,x86_64-linux-user --disable-docs --disable-werror --disable-tools --disable-guest-agent && ninja -j{jobs}"
      ],
      "description": "QEMU built with TCG plugin support; the frontend is loaded with -plugin"
    },
    "qemu-riscv-ime": {
      "kind": "build",
      "from": [
        "qemu"
      ],
      "copy_from": "qemu",
      "install_path": "qemu-riscv",
      "when": [
        "riscv-ime"
      ],
      "marker": "build/qemu-riscv64",
      "workdir": "{install}",
      "env": {},
      "command": [
        "sh",
        "-c",
        "git apply {root}/tools/riscv/qemu-11.1.1-ime.patch && mkdir -p build && cd build && ../configure --enable-plugins --target-list=riscv64-linux-user --disable-docs --disable-werror --disable-tools --disable-guest-agent && ninja -j{jobs}"
      ],
      "description": "QEMU 11.1.1 riscv64 user mode with the IME 0.9 (Zvvm) patch from tools/riscv/qemu-11.1.1-ime.patch and TCG plugin support; run with -cpu max,vlen=128,x-zvvmm=on,x-zvvfmm=on,x-zvvmtls=on (vlen up to 4096)"
    },
    "sail-riscv": {
      "kind": "tarball",
      "url": "https://github.com/riscv/sail-riscv/releases/download/0.14.1/sail-riscv-Linux-x86_64.tar.gz",
      "version": "0.14.1",
      "sha256": "de45a89748ca67a8a522b3ac0924c303b5609a16bb50d759bbd08c4d440df0eb",
      "install_path": "sail-riscv",
      "when": [
        "riscv-ime"
      ],
      "marker": "bin/sail_riscv_sim",
      "description": "sail-riscv 0.14.1 prebuilt model (RVV 1.0): the golden functional reference the riscv-gemm-sail check runs the vector workload on",
      "strip_components": 1
    },
    "mpich-src": {
      "kind": "tarball",
      "version": "4.2.3",
      "url": "https://www.mpich.org/static/downloads/4.2.3/mpich-4.2.3.tar.gz",
      "sha256": "7a019180c51d1738ad9c5d8d452314de65e828ee240bcb2d1f80de9a65be88a8",
      "strip_components": 1,
      "install_path": "mpich-src",
      "when": [
        "mpi"
      ],
      "marker": "configure",
      "description": "MPICH source. Needed only for the MPI tests in test/mpi and test/mpi-omp, which need an mpicc to build with and an mpirun to launch under; no distribution MPI is assumed"
    },
    "mpich": {
      "kind": "build",
      "from": [
        "mpich-src"
      ],
      "install_path": "mpich",
      "when": [
        "mpi"
      ],
      "marker": "bin/mpicc",
      "workdir": "{dep:mpich-src}",
      "command": [
        "sh",
        "-c",
        "mkdir -p {build} && cd {build} && {dep:mpich-src}/configure --prefix={install} --with-device=ch3:nemesis --disable-fortran --disable-cxx --disable-opencl --without-cuda --without-hip --disable-doc && make -j{jobs} && make install"
      ],
      "description": "MPICH built for the MPI tests. Configured out of tree so the shared source cache stays clean, and cut down to what those tests use: the nemesis/tcp device, no Fortran, no C++ bindings, no GPU support"
    }
  }
}
