CLEAN=$(findstring clean,$(MAKECMDGOALS))
ifneq ($(CLEAN),clean)

# Where the build put buildconf.makefile.  There is one per build directory, so
# honour $SNIPER_BUILD_DIR -- run-sniper sets it, and a shell that has picked a
# build exports it -- and fall back to the conventional build/default.
SNIPER_ROOT ?= ../..
SNIPER_BUILD_DIR ?= $(SNIPER_ROOT)/build/default
SNIPER_BUILDCONF := $(SNIPER_BUILD_DIR)/config/buildconf.makefile

include $(SNIPER_BUILDCONF)

ifeq ($(TARGET),)
$(error The TARGET variable must be set to use the shared Makefile)
endif

CC=$(SNIPER_CC)
LDFLAGS=$(SNIPER_LDFLAGS)
CFLAGS=$(SNIPER_CFLAGS)

# '--roi' allows for ROI timing with program hooks instead of full-program timing
# See ${SNIPER_ROOT}/include/sim_api.h for more information
run: $(TARGET) run_$(TARGET)
	@echo

$(SNIPER_BUILDCONF):
	@echo
	@echo
	@echo 'Error: A compiled version of Sniper is required to run the test applications'
	@echo '       Looked in $(SNIPER_BUILD_DIR); build one, or set SNIPER_BUILD_DIR.'
	@echo
	@false

endif

clean:
	rm -rf $(TARGET) sim.* *.log *.out *.png *.o topo.* power.* $(CLEAN_EXTRA)
