SIM_ROOT ?= $(shell readlink -f "$(CURDIR)/../")

include $(SIM_ROOT)/Makefile.config

DIRECTORIES := ${shell find $(SIM_ROOT)/common -type d -print} \
	$(SIM_ROOT)/include \
	$(SIM_ROOT)/../ChampSim/inc

LIBCARBON_SOURCES = $(foreach dir,$(DIRECTORIES),$(wildcard $(dir)/*.cc)) \
	$(wildcard $(SIM_ROOT)/common/config/*.cpp)

LIBCARBON_OBJECTS = $(patsubst %.cpp,%.o,$(patsubst %.c,%.o,$(patsubst %.cc,%.o,$(LIBCARBON_SOURCES) ) ) )

INCLUDE_DIRECTORIES = $(DIRECTORIES) $(XED_HOME)/include/xed $(SIM_ROOT)/linux $(SIM_ROOT)/sift $(SIM_ROOT)/include $(SIM_ROOT)/decoder_lib

# libtorch headers use -isystem to prevent collision between common/misc/semaphore.h
# and the system POSIX semaphore.h (pulled in by C++20 <semaphore> via libtorch)
ifneq ($(NO_TORCH),1)
TORCH_INCLUDES = -isystem $(SIM_ROOT)/libtorch/include -isystem $(SIM_ROOT)/libtorch/include/torch/csrc/api/include
else
TORCH_INCLUDES =
endif

CLEAN=$(findstring clean,$(MAKECMDGOALS))

ifeq ($(SNIPER_TARGET_ARCH),ia32)
  # Add -march=i686 to enable some extra instructions that allow for implementation of 64-bit atomic adds
  CXXFLAGS += -m32 -march=i686 -DTARGET_IA32
  LD_FLAGS += -m32
endif
ifeq ($(SNIPER_TARGET_ARCH),intel64)
  CXXFLAGS += -fPIC -DTARGET_INTEL64 -DTARGET_IA32E
  LD_FLAGS +=
endif

CXXFLAGS += -DPIN_REV=$(shell $(SIM_ROOT)/tools/pinversion.py $(PIN_HOME) | cut -d. -f3)

ifeq ($(BUILD_RISCV),0)
CXXFLAGS += -DSNIPER_RISCV=0
else
CXXFLAGS += -DSNIPER_RISCV=1
endif

ifeq ($(BUILD_ARM),0)
CXXFLAGS += -DSNIPER_ARM=0
else
CXXFLAGS += -DSNIPER_ARM=1
endif

include $(SIM_ROOT)/Makefile.config

ifneq ($(BOOST_INCLUDE),)
	CPPFLAGS += -I$(BOOST_INCLUDE)
endif

# Python interpreter used for the embedded scripting hooks (common/scripting).
# Override PYTHON_CONFIG to build against an interpreter that is not the system
# python3 -- conda, pyenv, spack, an HPC `module load python`, etc:
#   make PYTHON_CONFIG=/opt/python-3.12/bin/python3-config
comma := ,
PYTHON_CONFIG ?= python3-config
ifeq ($(CLEAN),)
  ifeq ($(shell command -v $(PYTHON_CONFIG) 2>/dev/null),)
    $(error Cannot find '$(PYTHON_CONFIG)'. Install python3-dev / python3-devel, or set \
            PYTHON_CONFIG to the python3-config of the interpreter to build against.)
  endif
endif
PYTHON_LD_LIBS := $(shell $(PYTHON_CONFIG) --libs --embed)
# --ldflags carries the -L for libpython; --libs alone does not, so linking against
# any interpreter outside the default linker search path fails without this.
PYTHON_LD_FLAGS := $(shell $(PYTHON_CONFIG) --ldflags)
# Record libpython's directory in the binary so it is also found at run time,
# without each caller having to set LD_LIBRARY_PATH by hand.
PYTHON_LIB_DIR := $(patsubst -L%,%,$(filter -L%,$(PYTHON_LD_FLAGS)))
PYTHON_RPATH := $(foreach d,$(PYTHON_LIB_DIR),-Wl$(comma)-rpath$(comma)$(d))
HAVE_LZMA := $(shell printf 'int main() { return 0; }\n' | $(CXX) -xc++ - -llzma >/dev/null 2>&1 && echo 1 || echo 0)
LZMA_LINK_LIBS := $(if $(filter 1,$(HAVE_LZMA)),-llzma,)
# Keyed off the option, not off whether a previous build left the tarball behind:
# probing the filesystem meant NO_TORCH=1 still linked torch on any tree that had
# ever been built without it.
ifneq ($(NO_TORCH),1)
TORCH_LINK_LIBS := $(if $(wildcard $(SIM_ROOT)/libtorch/lib/libtorch.so),-ltorch,) $(if $(wildcard $(SIM_ROOT)/libtorch/lib/libc10.so),-lc10,)
else
TORCH_LINK_LIBS :=
endif
LD_LIBS += -ldecoder -lsift -lxed -lrt -lz -lbz2 $(LZMA_LINK_LIBS) -lsqlite3 $(PYTHON_LD_LIBS) $(TORCH_LINK_LIBS)

LD_FLAGS += -L$(SIM_ROOT)/lib -L$(SIM_ROOT)/decoder_lib/ -L$(SIM_ROOT)/sift -L$(XED_HOME)/lib -L$(SIM_ROOT)/libtorch/lib
LD_FLAGS += $(PYTHON_LD_FLAGS) $(PYTHON_RPATH)

ifneq ($(SQLITE_PATH),)
	CPPFLAGS += -I$(SQLITE_PATH)/include
	LD_FLAGS += -L$(SQLITE_PATH)/lib
endif

export LD_LIBRARY_PATH := $(SIM_ROOT)/lib:$(LD_LIBRARY_PATH)

# Include paths
PYTHON_INCLUD_PATH := $(shell $(PYTHON_CONFIG) --includes)
CPPFLAGS+=$(foreach dir,$(INCLUDE_DIRECTORIES),-I$(dir)) \
	  $(PYTHON_INCLUD_PATH) \
          -I$(SIM_ROOT)/capstone/include -I$(SIM_ROOT)/capstone/include/capstone \
          $(TORCH_INCLUDES)

CXXFLAGS+=-c \
          -Wall -Wextra -Wcast-align -Wno-unused-parameter -Wno-unknown-pragmas -std=c++20 -fno-strict-aliasing -D_GLIBCXX_USE_CXX11_ABI=0 $(OPT_CFLAGS) #-Werror
#CXXFLAGS+=-I$(SIM_ROOT)/rv8/src
#CXXFLAGS+=-I$(SIM_ROOT)/rv8

%.h %.hh %.hpp:
	@echo >&2
	@echo "        Unable to find $@" >&2
	@echo "        You may want to try running 'make empty_deps'" >&2
	@echo >&2
	@false

# Build rules for dependency generation
%.d: %.cpp
	$(_MSG) '[DEP   ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CXX) -MM -MG $(CPPFLAGS) $(CXXFLAGS) $< | sed -n "H;$$ {g;s@.*:\(.*\)@$*.o $@: \$$\(wildcard\1\)@;p}" >$@

%.d: %.cc
	$(_MSG) '[DEP   ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CXX) -MM -MG $(CPPFLAGS) $(CXXFLAGS) $< | sed -n "H;$$ {g;s@.*:\(.*\)@$*.o $@: \$$\(wildcard\1\)@;p}" >$@

%.d: %.c
	$(_MSG) '[DEP   ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CC) -MM -MG $(CPPFLAGS) $(CFLAGS) $< | sed -n "H;$$ {g;s@.*:\(.*\)@$*.o $@: \$$\(wildcard\1\)@;p}" >$@

# Build rules for object generation
%.o: %.cpp
	$(_MSG) '[CXX   ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

%.o : %.cc
	$(_MSG) '[CXX   ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

%.o : %.c
	$(_MSG) '[CC    ]' $(subst $(shell readlink -f $(SIM_ROOT))/,,$(shell readlink -f $@))
	$(_CMD) $(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
